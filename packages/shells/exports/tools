#!/usr/bin/env bash

# shellcheck disable=SC1072,SC1073,SC1054,SC1056,SC1083,SC1009

# Claude Code Telemetry and Exit Speed Optimization
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export CLAUDE_CODE_USE_BEDROCK=0
export CLAUDE_USE_BEDROCK=0
export DISABLE_BEDROCK=1

FNOX_AGE_KEY_FILE="$HOME/.config/fnox/age.txt"
FNOX_AGE_KEY=$(cat "$FNOX_AGE_KEY_FILE" | grep "AGE-SECRET-KEY")
export FNOX_AGE_KEY

if which op >/dev/null && [[ -f "$HOME/.config/op/plugins.sh" ]]; then
	# shellcheck source=/dev/null
	source "$HOME/.config/op/plugins.sh"
fi