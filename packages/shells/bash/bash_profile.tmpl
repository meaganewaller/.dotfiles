# Source .bashrc for login shells (like SSH sessions)
if [ -f ~/.bashrc ]; then
   source ~/.bashrc
fi

[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
# macOS specific setup (only if files exist)
{%- if os == "macos" %}
	[ -f "/opt/homebrew/bin/brew" ] && eval "$(/opt/homebrew/bin/brew shellenv)"
{%- endif %}

. "$HOME/.atuin/bin/env"
