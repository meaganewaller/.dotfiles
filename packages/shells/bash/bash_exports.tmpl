#!/bin/bash

export FCEDIT={{ editor.default }}
export EDITOR={{ editor.default }}
export SUDO_EDITOR={{ editor.default }}

# Load machine-specific exports FIRST (allows DOTFILES_ROOT override for custom clone locations)
# See README.md "Custom Clone Location" section for details
if [ -f ~/.bash_exports.local ]; then
		# shellcheck disable=SC1090
		. ~/.bash_exports.local
fi
