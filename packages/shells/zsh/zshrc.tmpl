# vim:ft=zsh
# shellcheck shell=bash
# shellcheck disable=SC1036,SC2034,SC2296,SC2154,SC1072,SC1056,SC1083,SC1009
#
#  ╭─────────────────────────────╮
#  │  Z-Shell interactive config │
#  │  {{ user.name }}            │
#  │  github.com/{{ user.github }} │
#  ╰─────────────────────────────╯
#
# Sourced for interactive shells. Login-shell env (PATH, XDG_*, EDITOR) lives
# in .zshenv. Application env vars live in $SHELL_CONFIG/*.env. Aliases live
# in $SHELL_CONFIG/aliasrc. Functions are autoloaded from
# $SHELL_CONFIG/functions and $DOTFILES/zsh/.zsh/functions.
#
# Order of operations matters:
#   1. setopt + history          ─ cheap, no deps
#   2. autoloads + modules       ─ make zfetch et al. callable
#   3. env files + aliasrc       ─ $SHELL_CONFIG already known from .zshenv
#   4. plugins (pre-compinit)    ─ async, base16, autosuggestions
#   5. compinit                  ─ once-a-day cache for fast startup
#   6. plugins (post-compinit)   ─ fzf-tab, history-substring-search,
#                                  syntax-highlighting (LAST)
#   7. keybinds
#   8. tool integrations         ─ fnm, fzf, zoxide, kitty, brew helpfiles
#   9. snippet dir + local rc

#───────────────────────────────────────────────────────────────────────────────
# Initial Prerequisites
#───────────────────────────────────────────────────────────────────────────────

{# Rendered by mise run link from vars (from vars/os/*.toml). #}
# shellcheck disable=SC1054
{%- if zsh.enable_zprof %}
zmodload zsh/zprof
{%- endif %}

autoload -Uz compinit && compinit
compinit -d "$XDG_DATA_HOME/zsh/compdump"

fpath=($HOME/.config/zsh/plugins $fpath)
source {{ paths.homebrew_prefix }}/share/zsh-autosuggestions/zsh-autosuggestions.zsh

########################################
# Exports & Environment Variables
########################################
GPG_TTY="$(tty)"
export GPG_TTY

export EXPORTS_DIR="$HOME/{{ zsh.exports_relative }}"

# Create exports directory if it doesn't exist
[ ! -d "$EXPORTS_DIR" ] && mkdir -p "$EXPORTS_DIR"

load_exports() {
	if [ -d "$EXPORTS_DIR" ]; then
		# Only source files that exist and are readable
		for export_file in "$EXPORTS_DIR"/*; do
			if [ -f "$export_file" ] && [ -r "$export_file" ]; then
				# shellcheck source=/dev/null
				source "$export_file"
			fi
		done
	fi
}

edit_exports() {
	local file=${1:-main}
	local filepath="$EXPORTS_DIR/$file"

	# Create the file if it doesn't exist
	[ ! -f "$filepath" ] && touch "$filepath"

	${EDITOR:-"{{ editor.default }}"} "$filepath"
}

reload_exports() {
    load_exports
    echo "Exports reloaded from $EXPORTS_DIR"
}

# Load exports on startup (only if directory exists and has files)
if [ -d "$EXPORTS_DIR" ] && [ "$(ls -A "$EXPORTS_DIR" 2>/dev/null)" ]; then
    load_exports
fi

########################################
# Base PATH
########################################
export PATH="$HOME/.local/bin:$PATH"

########################################
# Emacs Keymap
########################################

# emacs mode (terminal only)
bindkey -e

# Press <delete> to delete characters instead of producing a ~
bindkey "^[[3~" delete-char

########################################
# Dotfiles bin
########################################
if [[ -n "${DOTFILES_ROOT:-}" ]]; then
  export PATH="$DOTFILES_ROOT/bin:$PATH"
fi

########################################
# Environment loader (optional tools)
########################################
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"

########################################
# zsh options
########################################
setopt APPEND_HISTORY         # Append to history file instead of overwriting
setopt EXTENDED_HISTORY       # Write the history file in the ':start:elapsed;command' format
setopt HIST_IGNORE_DUPS       # Do not record an event that was just recorded again
setopt HIST_IGNORE_ALL_DUPS   # Remove older duplicates
setopt HIST_IGNORE_SPACE      # Ignore commands that start with a space
setopt HIST_NO_FUNCTIONS      # Don't save functions to history
setopt HIST_VERIFY            # Don't execute immediately when picking from history
setopt HIST_REDUCE_BLANKS     # Remove extra blanks from history
setopt INC_APPEND_HISTORY     # Append history incrementally
setopt SHARE_HISTORY          # Share history between all sessions


########################################
# Runtime: mise
########################################

# This now lives in $HOME/.config/shells/exports/tools, and gets loaded in the ~/.zshenv file


########################################
# Aliases
########################################
[[ -f ${HOME}/.config/shells/aliases.sh ]] && source ${HOME}/.config/shells/aliases.sh

########################################
# Claude Bedrock prevention
########################################
{% if zsh.disable_claude_bedrock_exports %}
export CLAUDE_CODE_USE_BEDROCK=0
export CLAUDE_USE_BEDROCK=0
export DISABLE_BEDROCK=1
{% endif %}

########################################
# Utility Functions
########################################

load_functions() {
   if [ -d "$HOME"/.config/shells/functions ]; then
      for function_file in "$HOME"/.config/shells/functions/*; do
         if [ -f "$function_file" ] && [ -r "$function_file" ]; then
            # shellcheck source=/dev/null
            source "$function_file"
         fi
      done
   fi
}

if [ -d "$HOME"/.config/shells/functions ] && [ "$(ls -A "$HOME"/.config/shells/functions 2>/dev/null)" ]; then
   load_functions
fi

{% if os == "macos" %}
function cursor {
	(nohup "{{ zsh.cursor_gui_bin }}" "$@" > /dev/null 2>&1 &)
}
# shellcheck disable=SC1073
{% endif %}

########################################
# Autocompletion
########################################

setopt auto_cd
setopt correct
setopt glob_dots
setopt hist_ignore_all_dups
setopt hist_reduce_blanks
setopt list_types
setopt print_eight_bit
setopt share_history

autoload -Uz select-word-style
select-word-style default
zstyle ':zle:*' word-chars ' -_,.;:"()[]{}@/=|'
zstyle ':zle:*' word-style unspecified

zstyle ':completion:*:default' menu select=1
bindkey '^[[Z' reverse-menu-complete
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

export HISTFILE="$XDG_DATA_HOME/zsh/history"
mkdir -p "$(dirname "$HISTFILE")"
export HISTSIZE={{ zsh.hist_size }}
export SAVEHIST={{ zsh.hist_size }}

_comp_options+=(globdots) # With hidden files

source "$HOME/.config/zsh/bindings.zsh"
source "$HOME/.config/zsh/completion.zsh"
_ZSH_SYNTAX_HL="$HOME/.config/zsh/{{ zsh.syntax_highlighting_relative }}"
[[ -f "$_ZSH_SYNTAX_HL" ]] && source "$_ZSH_SYNTAX_HL"
unset _ZSH_SYNTAX_HL

PS1='%F{blue}%B%~%b%f %F{green}❯%f '
precmd () { print -Pn "\e]2;%-3~\a"; }
