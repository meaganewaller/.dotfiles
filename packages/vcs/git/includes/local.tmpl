# Generated from packages/vcs/git/includes/local.tmpl
# Profile: {{ profile }} | Generated: {{ now() }}

# Work identity: by remote URL pattern (most reliable)
[includeIf "hasconfig:remote.*.url:*gusto/*"]
  path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:*Gusto-org/*"]
  path = ~/.gitconfig.work

# Work identity: by local directory
[includeIf "gitdir:{{ home }}/workspace/**"]
  path = ~/.gitconfig.work
[includeIf "gitdir:{{ home }}/work/**"]
  path = ~/.gitconfig.work

# Personal identity: by remote URL
[includeIf "hasconfig:remote.*.url:*meaganewaller/*"]
  path = ~/.gitconfig.personal
[includeIf "hasconfig:remote.*.url:*garbagecollectorsdaughter/*"]
  path = ~/.gitconfig.personal

# Personal identity: by local directory
[includeIf "gitdir:{{ home }}/github/meaganewaller/**"]
  path = ~/.gitconfig.personal
[includeIf "gitdir:{{ home }}/github/garbagecollectorsdaughter/**"]
  path = ~/.gitconfig.personal
[includeIf "gitdir:{{ home }}/personal/**"]
  path = ~/.gitconfig.personal
