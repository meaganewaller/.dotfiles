#!/usr/bin/env bash
# Pull API tokens from 1Password once, write gitignored files for shells to source.
# New shells do not call op — only re-run this after you rotate a token.
#
#   DOTFILES_ROOT/bin/generate-api-keys --refresh   # requires: op signin
#
# Files (default ~/.config/dotfiles/):
#   secrets.env   — source from bash/zsh:  source ~/.config/dotfiles/secrets.env
#   secrets.fish  — source from fish:      source ~/.config/dotfiles/secrets.fish
#
# Update 1Password from stdin (then run --refresh to refresh local files):
#   printf '%s' "$NEW_TOKEN" | DOTFILES_ROOT/bin/generate-api-keys --write MISE_GITHUB_TOKEN
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_ROOT="${DOTFILES_ROOT:-$ROOT}"

SECRETS_DIR="${DOTFILES_SECRETS_DIR:-${HOME}/.config/dotfiles}"
SECRETS_ENV="${SECRETS_DIR}/secrets.env"
SECRETS_FISH="${SECRETS_DIR}/secrets.fish"

log() { printf '[generate-api-keys] %s\n' "$*" >&2; }

SECRET_ORDER=(MISE_GITHUB_TOKEN WAKATIME_API_KEY HOMEBREW_GITHUB_API_TOKEN)

op_ref_for() {
  case "$1" in
  MISE_GITHUB_TOKEN) echo "op://Development/Mise GitHub Personal Access Token/token" ;;
  WAKATIME_API_KEY) echo "op://Development/WakaTime Key/credential" ;;
  HOMEBREW_GITHUB_API_TOKEN) echo "op://Development/Homebrew GitHub API Token/credential" ;;
  *) return 1 ;;
  esac
}

op_write_target_for() {
  case "$1" in
  MISE_GITHUB_TOKEN) echo $'Mise GitHub Personal Access Token\ttoken' ;;
  WAKATIME_API_KEY) echo $'WakaTime Key\tcredential' ;;
  HOMEBREW_GITHUB_API_TOKEN) echo $'Homebrew GitHub API Token\tcredential' ;;
  *) return 1 ;;
  esac
}

require_op() {
  if ! command -v op >/dev/null 2>&1; then
    log "1Password CLI (op) not found. Install: https://developer.1password.com/docs/cli/"
    exit 1
  fi
  if ! op whoami >/dev/null 2>&1; then
    log "Not signed in to 1Password. Run: op signin"
    exit 1
  fi
}

fish_set_line() {
  # stdin = raw value; argv = var name
  python3 - "$1" <<'PY'
import sys
name = sys.argv[1]
val = sys.stdin.read()
q = "'" + val.replace("'", "'\\''") + "'"
print(f"set -gx {name} {q}")
PY
}

cmd_refresh() {
  require_op
  if ! command -v python3 >/dev/null 2>&1; then
    log "python3 is required to generate secrets.fish"
    exit 1
  fi
  mkdir -p "$SECRETS_DIR"
  local name ref val tmp
  local vals
  vals=()
  for name in "${SECRET_ORDER[@]}"; do
    ref="$(op_ref_for "$name")"
    vals+=("$(op read "$ref")")
  done

  tmp="$(mktemp)"
  {
    echo "# Generated by generate-api-keys --refresh. Do not commit."
    echo "# Regenerate: \"\${DOTFILES_ROOT}/bin/generate-api-keys\" --refresh"
    for i in "${!SECRET_ORDER[@]}"; do
      name="${SECRET_ORDER[$i]}"
      val="${vals[$i]}"
      printf 'export %s=%q\n' "$name" "$val"
    done
  } >"$tmp"
  mv "$tmp" "$SECRETS_ENV"
  chmod 600 "$SECRETS_ENV"

  tmp="$(mktemp)"
  {
    echo "# Generated by generate-api-keys --refresh. Do not commit."
    echo "# Regenerate: \"\${DOTFILES_ROOT}/bin/generate-api-keys\" --refresh"
    for i in "${!SECRET_ORDER[@]}"; do
      name="${SECRET_ORDER[$i]}"
      val="${vals[$i]}"
      printf '%s' "$val" | fish_set_line "$name"
    done
  } >"$tmp"
  mv "$tmp" "$SECRETS_FISH"
  chmod 600 "$SECRETS_FISH"

  log "Wrote (mode 600): $SECRETS_ENV"
  log "Wrote (mode 600): $SECRETS_FISH"
  log "Shells source these on startup (see dotfiles home/.config/fish and .zshrc)."
}

cmd_print() {
  require_op
  local name ref val
  for name in "${SECRET_ORDER[@]}"; do
    ref="$(op_ref_for "$name")"
    val="$(op read "$ref")"
    printf 'export %s=%q\n' "$name" "$val"
  done
}

cmd_write() {
  local var="$1"
  require_op
  local target item field
  target="$(op_write_target_for "$var")" || {
    log "Unknown variable: $var (valid: ${SECRET_ORDER[*]})"
    exit 1
  }
  item="${target%%	*}"
  field="${target#*	}"
  local value
  value="$(cat)"
  if [[ -z "$value" ]]; then
    log "Refusing to write empty value (stdin was empty)"
    exit 1
  fi
  log "Updating 1Password item: $item ($field)"
  op item edit "$item" --vault Development "${field}=${value}" >/dev/null
  log "Updated $var in 1Password. Run: $0 --refresh"
}

usage() {
  cat <<EOF
Usage:
  generate-api-keys --refresh     Read from 1Password once; write:
                                    $SECRETS_ENV   (bash/zsh: source)
                                    $SECRETS_FISH  (fish: source)
  generate-api-keys --print       Print bash exports to stdout (no files; still uses op)
  generate-api-keys --write VAR   Read new secret from stdin; update 1Password item

Environment:
  DOTFILES_SECRETS_DIR   Override directory (default: ~/.config/dotfiles)
  Requires 1Password CLI for --refresh, --print, and --write.

Typical workflow:
  1. op signin
  2. "\${DOTFILES_ROOT:-$ROOT}/bin/generate-api-keys" --refresh
  3. Open a new shell — secrets load from files, no op prompt.
EOF
}

main() {
  case "${1:-}" in
  -h | --help | help)
    usage
    ;;
  --refresh | refresh)
    cmd_refresh
    ;;
  --print)
    cmd_print
    ;;
  --write)
    if [[ -z "${2:-}" ]]; then
      log "usage: $0 --write <VAR>"
      exit 1
    fi
    cmd_write "$2"
    ;;
  "")
    cmd_refresh
    ;;
  *)
    log "Unknown option: $1"
    usage
    exit 1
    ;;
  esac
}

main "$@"
