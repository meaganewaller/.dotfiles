#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_ROOT="$ROOT"

PROFILE="${DOTFILES_PROFILE:-work}"
DOTFILES_DRY_RUN="${DOTFILES_DRY_RUN:-0}"

source "$ROOT/bin/make-symlink"

log() {
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    printf '[link (dry)] %s\n' "$*"
  else
    printf '[link] %s\n' "$*"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile) PROFILE="$2"; shift 2 ;;
    --dry-run) DOTFILES_DRY_RUN=1; shift ;;
    *) log "Unknown arg: $1"; exit 1 ;;
  esac
done

export DOTFILES_PROFILE DOTFILES_DRY_RUN

run() {
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    log "Would link $*"
  else
    log "Linking $*"
    make_symlink "$@"
  fi
}

run ".zshrc"
run ".zshenv"
run ".bashrc"

run ".gitconfig"
run ".gitconfig.work"
run ".gitconfig.personal"
run ".gitconfig.local" || true
run ".gitignore_global"

run ".ssh/config"
run ".ssh/config.work"
run ".ssh/config.personal"

run ".editorconfig"
run ".config/wezterm"
run ".config/nvim"
run ".config/theme"
run ".config/zsh"
run ".config/fish"
run ".local/bin/theme"
run ".local/bin/dotfiles"

if [[ "$PROFILE" == "work" ]]; then
  log "Linking work dotfiles"
  run ".hammerspoon"
  run ".config/karabiner"
  run ".config/sketchybar"
fi

if [[ "$PROFILE" == "personal" ]]; then
  log "Linking personal dotfiles"
  run ".hammerspoon"
  run ".config/karabiner"
  run ".config/sketchybar"
fi

log "Done linking."
