#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_ROOT="$ROOT"

PROFILE="${DOTFILES_PROFILE:-work}"
DOTFILES_DRY_RUN="${DOTFILES_DRY_RUN:-0}"
ONLY_MISE=0

# shellcheck source=/dev/null
source "$ROOT/lib/common.sh"
# shellcheck source=/dev/null
source "$ROOT/bin/make-symlink"

log() {
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    printf '[link (dry)] %s\n' "$*"
  else
    printf '[link] %s\n' "$*"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --profile)
    PROFILE="$2"
    shift 2
    ;;
  --dry-run)
    DOTFILES_DRY_RUN=1
    shift
    ;;
  --only-mise)
    ONLY_MISE=1
    shift
    ;;
  *)
    log "Unknown arg: $1"
    exit 1
    ;;
  esac
done

export DOTFILES_PROFILE="$PROFILE" DOTFILES_DRY_RUN

validate_profile "$PROFILE"

run() {
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    log "Would link $*"
  else
    log "Linking $*"
    make_symlink "$@"
  fi
}

run_to() {
  local src_rel="$1"
  local dest_rel="$2"
  local src="$DOTFILES_ROOT/home/$src_rel"
  local dest="$HOME/$dest_rel"
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    log "Would link $src_rel -> $dest_rel"
  else
    log "Linking $src_rel -> $dest_rel"
    make_symlink "$src" "$dest"
  fi
}

run_dir_contents() {
  local rel="$1"
  shift
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    log "Would link contents of $rel (excluding README)"
  else
    log "Linking contents of $rel (excluding README)"
    make_symlink_dir_contents "$rel" "$@"
  fi
}

# Symlink ~/.config/mise/miserc.toml -> miserc.<profile>.toml (gitignored).
link_mise_miserc() {
  local d="$HOME/.config/mise"
  local src="miserc.${PROFILE}.toml"
  if [[ ! -d "$d" ]]; then
    log "Skip miserc.toml ($d missing; link .config/mise first)"
    return 0
  fi
  if [[ ! -e "$d/$src" ]]; then
    log "Skip miserc.toml (no $src in $d)"
    return 0
  fi
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    log "Would symlink $d/miserc.toml -> $src"
    return 0
  fi
  (cd "$d" && ln -sfn "$src" miserc.toml)
  log "Linked mise miserc.toml -> $src"
}

if [[ "$ONLY_MISE" -eq 1 ]]; then
  run ".config/mise"
  link_mise_miserc
  log "Done linking (mise only)."
  exit 0
fi

run ".bash_aliases"
run ".bash_exports"
run ".bash_exports.local"
run ".bash_profile"
run ".bash_secrets"
run ".bashrc"
run ".bash_aliases.d"

run ".gitconfig"
run ".gitconfig.work"
run ".gitconfig.personal"
run ".gitconfig.local" || true

run ".ssh/config"
run ".ssh/config.work"
run ".ssh/config.personal"

run ".editorconfig"
run ".config/wezterm"
run ".config/nvim"
run ".config/theme"
run_dir_contents ".config/bat"
run_dir_contents ".config/exports"
run_dir_contents ".config/btop"
run_dir_contents ".config/fd"
run_dir_contents ".config/gh"
run_dir_contents ".config/git"
run_dir_contents ".config/htop"
run_dir_contents ".config/lazydocker"
run_dir_contents ".config/fish" # links contents only; README.md stays in repo
run_dir_contents ".config/rg"
run ".local/bin/theme"
run ".local/bin/dotfiles"
run ".local/bin/tradeoff"
run ".local/bin/tradeoff-gate"
run ".local/bin/aerospace-keys"
run ".local/bin/aerospace-keys-popup"
run ".aerospace.toml"

# run_dir_contents ".config/ghostty"
run_dir_contents ".config/wezterm"

run ".config/mise"
link_mise_miserc

run ".config/atuin/config.toml"
run_dir_contents ".config/yazi"

run ".config/borders/bordersrc"

run_dir_contents ".config/tmux"
run_dir_contents ".config/lazygit"

if [[ "$PROFILE" == "work" ]]; then
  log "Linking work dotfiles"
  run ".zshrc"
  run_dir_contents ".config/zsh"
  run ".hammerspoon"
  run ".config/karabiner"
  run ".config/sketchybar"
fi

if [[ "$PROFILE" == "personal" ]]; then
  log "Linking personal dotfiles"
  run_dir_contents ".config/fish"
  run ".hammerspoon"
  run ".config/karabiner"
  run ".config/sketchybar"
fi

if [[ "$PROFILE" == "server" ]]; then
  log "Linking server dotfiles"
  # Server: minimal CLI-focused setup, no GUI apps
fi

if [[ "$PROFILE" == "container" ]]; then
  log "Linking container dotfiles"
  # Container: minimal setup for devcontainers
  # Most links already done above (shell, git, editor configs)
fi

# Claude Code configuration (hooks, cues, settings, etc.)
# Uses dedicated install script that handles profile-based merging
if [[ -x "$ROOT/home/.claude/install.sh" ]]; then
  log "Running Claude Code install..."
  CLAUDE_INSTALL_ARGS=(--profile "$PROFILE")
  [[ "$DOTFILES_DRY_RUN" -eq 1 ]] && CLAUDE_INSTALL_ARGS+=(--dry-run)
  "$ROOT/home/.claude/install.sh" "${CLAUDE_INSTALL_ARGS[@]}"
fi

log "Done linking."
