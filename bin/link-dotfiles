#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_ROOT="$ROOT"

PROFILE="${DOTFILES_PROFILE:-work}"
DOTFILES_DRY_RUN="${DOTFILES_DRY_RUN:-0}"

source "$ROOT/bin/make-symlink"

log() {
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    printf '[link (dry)] %s\n' "$*"
  else
    printf '[link] %s\n' "$*"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile) PROFILE="$2"; shift 2 ;;
    --dry-run) DOTFILES_DRY_RUN=1; shift ;;
    *) log "Unknown arg: $1"; exit 1 ;;
  esac
done

export DOTFILES_PROFILE DOTFILES_DRY_RUN

run() {
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    log "Would link $*"
  else
    log "Linking $*"
    make_symlink "$@"
  fi
}

run_to() {
  local src_rel="$1"
  local dest_rel="$2"
  local src="$DOTFILES_ROOT/home/$src_rel"
  local dest="$HOME/$dest_rel"
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    log "Would link $src_rel -> $dest_rel"
  else
    log "Linking $src_rel -> $dest_rel"
    make_symlink "$src" "$dest"
  fi
}

run_dir_contents() {
  local rel="$1"
  shift
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    log "Would link contents of $rel (excluding README)"
  else
    log "Linking contents of $rel (excluding README)"
    make_symlink_dir_contents "$rel" "$@"
  fi
}

run ".zshrc"
run ".zsh_prompt"
run ".zprofile"
run ".bash_aliases"
run ".bash_exports"
run ".bash_exports.local"
run ".bash_profile"
run ".bash_secrets"
run ".bashrc"
run ".bash_aliases.d"

run ".gitconfig"
run ".gitconfig.work"
run ".gitconfig.personal"
run ".gitconfig.local" || true
run ".gitignore_global"

run ".ssh/config"
run ".ssh/config.work"
run ".ssh/config.personal"

run ".editorconfig"
run ".config/wezterm"
run ".config/nvim"
run ".config/theme"
run ".config/zsh"
run_dir_contents ".config/fish"   # links contents only; README.md stays in repo
run ".local/bin/theme"
run ".local/bin/dotfiles"
run ".local/bin/tradeoff"
run ".local/bin/tradeoff-gate"
run ".local/bin/codex-tradeoff"
run ".local/bin/codex-tradeoff-gate"
run ".local/bin/codex-weekly-review"
run ".local/bin/codex-governance"

run ".config/git/hooks"

run ".config/mise"
run_to ".config/.codex/config.toml" ".codex/config.toml"

run ".tmux.conf"
run ".tmux/settings.conf"
run ".tmux/bindings.conf"
run ".tmux/style.conf"

if [[ "$PROFILE" == "work" ]]; then
  log "Linking work dotfiles"
  run ".hammerspoon"
  run ".config/karabiner"
  run ".config/sketchybar"
fi

if [[ "$PROFILE" == "personal" ]]; then
  log "Linking personal dotfiles"
  run ".hammerspoon"
  run ".config/karabiner"
  run ".config/sketchybar"
fi

if [[ "$PROFILE" == "server" ]]; then
  log "Linking server dotfiles"
  # Server: minimal CLI-focused setup, no GUI apps
fi

if [[ "$PROFILE" == "container" ]]; then
  log "Linking container dotfiles"
  # Container: minimal setup for devcontainers
  # Most links already done above (shell, git, editor configs)
fi

log "Done linking."
