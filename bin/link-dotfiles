#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_ROOT="$ROOT"

PROFILE="${DOTFILES_PROFILE:-work}"
DOTFILES_DRY_RUN="${DOTFILES_DRY_RUN:-0}"

source "$ROOT/bin/make-symlink"

log() {
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    printf '[link (dry)] %s\n' "$*"
  else
    printf '[link] %s\n' "$*"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile) PROFILE="$2"; shift 2 ;;
    --dry-run) DOTFILES_DRY_RUN=1; shift ;;
    *) log "Unknown arg: $1"; exit 1 ;;
  esac
done

export DOTFILES_PROFILE DOTFILES_DRY_RUN

run() {
  if [[ "$DOTFILES_DRY_RUN" -eq 1 ]]; then
    log "Would link $*"
  else
    log "Linking $*"
    make_symlink "$@"
  fi
}

run ".zshrc"
run ".zshenv"
run ".bashrc"

run ".gitconfig"
run ".gitconfig.work"
run ".gitconfig.personal"
run ".gitconfig.local" || true
run ".gitignore_global"

run ".ssh/config"
run ".ssh/config.work"
run ".ssh/config.personal"

run ".editorconfig"
run ".config/wezterm"
run ".config/nvim"
run ".config/theme"
run ".config/zsh"
run ".config/fish"
run ".local/bin/theme"
run ".local/bin/dotfiles"

run ".config/mise"

if [[ "$PROFILE" == "work" ]]; then
  log "Linking work dotfiles"
  run ".hammerspoon"
  run ".config/karabiner"
  run ".config/sketchybar"

  if [[ "$DOTFILES_DRY_RUN" -eq 0 ]]; then
    log "Linking $DOTFILES_ROOT/home/.claude/work-settings.json to $HOME/.claude/settings.json"
    make_symlink "$DOTFILES_ROOT/home/.claude/work-settings.json" "$HOME/.claude/settings.json"

    log "Linking $DOTFILES_ROOT/home/.claude/skills/ruby-code-documenter to $HOME/.claude/skills/ruby-code-documenter"
    make_symlink "$DOTFILES_ROOT/home/.claude/skills/ruby-code-documenter" "$HOME/.claude/skills/ruby-code-documenter"

    log "Linking $DOTFILES_ROOT/home/.claude/skills/changelog-generator to $HOME/.claude/skills/changelog-generator"
    make_symlink "$DOTFILES_ROOT/home/.claude/skills/changelog-generator" "$HOME/.claude/skills/changelog-generator"
  else
    log "Dry-run: Would link $DOTFILES_ROOT/home/.claude/work-settings.json to $HOME/.claude/settings.json"
    log "Dry-run: Would link $DOTFILES_ROOT/home/.claude/skills/ruby-code-documenter to $HOME/.claude/skills/ruby-code-documenter"
    log "Dry-run: Would link $DOTFILES_ROOT/home/.claude/skills/changelog-generator to $HOME/.claude/skills/changelog-generator"
  fi
fi

if [[ "$PROFILE" == "personal" ]]; then
  log "Linking personal dotfiles"
  run ".hammerspoon"
  run ".config/karabiner"
  run ".config/sketchybar"
fi

if [[ "$PROFILE" == "server" ]]; then
  log "Linking server dotfiles"
  # Server: minimal CLI-focused setup, no GUI apps
fi

if [[ "$PROFILE" == "container" ]]; then
  log "Linking container dotfiles"
  # Container: minimal setup for devcontainers
  # Most links already done above (shell, git, editor configs)
fi

log "Done linking."
