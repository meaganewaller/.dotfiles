#!/usr/bin/env bash
set -euo pipefail

PROFILE="${1:-work}"

# Resolve dotfiles root (repo root)
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_ROOT="${DOTFILES_ROOT:-$ROOT}"

log() {
  printf '[dotfiles] %s\n' "$*"
}

make_symlink() {
  local rel="$1"          # e.g. ".zshrc" or ".ssh/config" or ".config/nvim"
  local src="${DOTFILES_ROOT}/home/${rel}"
  local dest="${HOME}/${rel}"

  # If the source doesn't exist in the repo, skip quietly
  if [ ! -e "$src" ] && [ ! -L "$src" ]; then
    log "Skipping ${rel} (no source at ${src})"
    return 0
  fi

  # Ensure parent directory exists (for things like .ssh/config, .config/nvim, etc.)
  local dest_dir
  dest_dir="$(dirname "$dest")"
  mkdir -p "$dest_dir"

  # If dest already exists, decide what to do
  if [ -L "$dest" ]; then
    # It's a symlink already
    local current
    current="$(readlink "$dest" || true)"
    if [ "$current" = "$src" ]; then
      log "Symlink already correct for ${dest}"
      return 0
    else
      log "Removing existing symlink ${dest} -> ${current}"
      rm "$dest"
    fi
  elif [ -e "$dest" ]; then
    # Real file/dir, not a symlink → back it up
    local backup="${dest}.backup.$(date +%s)"
    log "Backing up existing ${dest} -> ${backup}"
    mv "$dest" "$backup"
  fi

  # At this point, dest does not exist. Symlink file or directory.
  if [ -d "$src" ]; then
    log "Linking directory ${dest} -> ${src}"
  else
    log "Linking file ${dest} -> ${src}"
  fi

  ln -s "$src" "$dest"
}

log "Linking dotfiles for profile '${PROFILE}'"
log "DOTFILES_ROOT=${DOTFILES_ROOT}"

###############################################################################
# Shell config
###############################################################################

make_symlink ".zshrc"
make_symlink ".zshenv"
make_symlink ".bashrc"

###############################################################################
# Git config
###############################################################################

make_symlink ".gitconfig"
make_symlink ".gitconfig.work"
make_symlink ".gitconfig.personal"

###############################################################################
# SSH config
###############################################################################

make_symlink ".ssh/config"
make_symlink ".ssh/config.work"
make_symlink ".ssh/config.personal"


###############################################################################
# Editor / tooling config
###############################################################################

make_symlink ".editorconfig"
make_symlink ".config/starship.toml"
make_symlink ".config/wezterm"
make_symlink ".config/nvim"
make_symlink ".config/zsh"

# Optional: profile-specific shell overlays
# make_symlink ".zshrc.${PROFILE}" || true

log "Dotfile linking complete."
