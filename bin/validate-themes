#!/usr/bin/env python3
"""Validate theme JSON files against the schema."""
import json
import sys
import glob
import os
import re

THEMES_DIR = "home/.config/theme/themes"
SCHEMA_PATH = os.path.join(THEMES_DIR, "schema.json")
WALLPAPERS_DIR = "home/.config/theme/wallpapers"


def validate_hex_color(value):
    """Check if value is a valid hex color."""
    return bool(re.match(r"^#[0-9A-Fa-f]{6}$", value))


def validate_theme(filepath, schema):
    """Validate a single theme file."""
    errors = []
    warnings = []

    try:
        with open(filepath) as f:
            theme = json.load(f)
    except json.JSONDecodeError as e:
        return [f"invalid JSON: {e}"], []

    # Required fields
    if not theme.get("name"):
        errors.append("missing required field: name")

    if not theme.get("mode"):
        errors.append("missing required field: mode")
    elif theme.get("mode") not in ("light", "dark"):
        errors.append(f"invalid mode: {theme.get('mode')} (must be 'light' or 'dark')")

    # Accent validation
    accent = theme.get("accent")
    if accent:
        if not isinstance(accent, dict):
            errors.append("accent must be an object with 'name' and 'hex'")
        else:
            if not accent.get("name"):
                errors.append("accent.name is required")
            if not accent.get("hex"):
                errors.append("accent.hex is required")
            elif not validate_hex_color(accent.get("hex", "")):
                errors.append(f"accent.hex is not a valid hex color: {accent.get('hex')}")

    # Wallpaper validation (warning only)
    wallpaper = theme.get("wallpaper")
    if wallpaper:
        if not wallpaper.startswith("/"):
            wallpaper_path = os.path.join(WALLPAPERS_DIR, wallpaper)
        else:
            wallpaper_path = wallpaper
        if not os.path.isfile(wallpaper_path):
            warnings.append(f"wallpaper not found: {wallpaper_path}")

    # Check for unknown fields
    known_fields = {
        "$schema", "name", "mode", "accent", "wezterm", "nvim",
        "sketchybar", "vscode", "cursor", "wallpaper"
    }
    unknown = set(theme.keys()) - known_fields
    if unknown:
        warnings.append(f"unknown fields: {', '.join(unknown)}")

    return errors, warnings


def main():
    # Load schema
    if not os.path.isfile(SCHEMA_PATH):
        print(f"Warning: schema not found at {SCHEMA_PATH}")
        schema = None
    else:
        with open(SCHEMA_PATH) as f:
            schema = json.load(f)

    # Find theme files (exclude schema.json)
    theme_files = [
        f for f in glob.glob(os.path.join(THEMES_DIR, "*.json"))
        if not f.endswith("schema.json")
    ]

    if not theme_files:
        print(f"No theme files found in {THEMES_DIR}")
        return 0

    total_errors = 0
    total_warnings = 0

    for filepath in sorted(theme_files):
        name = os.path.basename(filepath)
        errors, warnings = validate_theme(filepath, schema)

        if errors or warnings:
            print(f"\n{name}:")
            for e in errors:
                print(f"  ERROR: {e}")
            for w in warnings:
                print(f"  WARNING: {w}")
            total_errors += len(errors)
            total_warnings += len(warnings)
        else:
            print(f"{name}: OK")

    print()
    if total_errors:
        print(f"Validation failed: {total_errors} error(s), {total_warnings} warning(s)")
        return 1
    elif total_warnings:
        print(f"Validation passed with {total_warnings} warning(s)")
        return 0
    else:
        print("All themes valid!")
        return 0


if __name__ == "__main__":
    sys.exit(main())
