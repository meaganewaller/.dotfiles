#!/usr/bin/env python3
"""Validate theme JSON files have required fields."""
import json
import sys
import glob
import os

themes_dir = "home/.config/theme/themes"
errors = []

for f in glob.glob(os.path.join(themes_dir, "*.json")):
    try:
        d = json.load(open(f))
        if not d.get("name"):
            errors.append(f"{f}: missing name")
        if not d.get("mode"):
            errors.append(f"{f}: missing mode")
        elif d.get("mode") not in ("light", "dark"):
            errors.append(f"{f}: invalid mode")
    except json.JSONDecodeError as e:
        errors.append(f"{f}: invalid JSON - {e}")

if errors:
    print("\n".join(errors))
    sys.exit(1)
