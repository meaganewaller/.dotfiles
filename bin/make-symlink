#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_ROOT="${DOTFILES_ROOT:-$ROOT}"

log() { printf '[symlink] %s\n' "$*"; }

make_symlink() {
  local src dest rel

  case "$#" in
    1)
      rel="$1"
      src="$DOTFILES_ROOT/home/$rel"
      dest="$HOME/$rel"
      ;;
    2)
      src="$1"
      dest="$2"
      ;;
    *)
      log "Usage: make_symlink <rel> or <src> <dest>"
      return 1
      ;;
  esac

  [[ -e "$src" || -L "$src" ]] || { log "Skip $dest (no source)"; return 0; }

  mkdir -p "$(dirname "$dest")"

  if [[ -L "$dest" ]]; then
    rm -f "$dest"
  elif [[ -e "$dest" ]]; then
    mv "$dest" "$dest.backup.$(date +%s)"
  fi

  ln -s "$src" "$dest"
}
