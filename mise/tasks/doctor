#!/usr/bin/env bash
#MISE description="Verify the dotfiles setup"
set -euo pipefail

source "$DOTFILES_ROOT/lib/common.sh"

step "Dotfiles doctor"

errors=0
check() {
  local name="$1" cmd="$2"
  if eval "$cmd" >/dev/null 2>&1; then
    info "  ✓ $name"
  else
    error "  ✗ $name"
    ((errors++))
  fi
}

log "Profile: ${DOTFILES_PROFILE:-?}"
log "OS: $DOTFILES_OS ($DOTFILES_ARCH)"
log ""

step "Required binaries"
for cmd in mise git gh op; do
  check "$cmd" "has $cmd"
done

step "Auth"
check "gh authenticated" "gh auth status"
check "op signed in" "op whoami"

step "Git configs"
for f in .gitconfig.work .gitconfig.personal .gitconfig.local; do
  check "$f exists" "[[ -f $HOME/$f ]]"
done

step "Symlinks"
linked=0
broken=0
while IFS= read -r -d '' link; do
  target="$(readlink "$link")"
  if [[ "$target" == "$DOTFILES_ROOT"/* ]]; then
    if [[ -e "$link" ]]; then
      ((linked++))
    else
      error "  Broken: $link → $target"
      ((broken++))
      ((errors++))
    fi
  fi
done < <(find "$HOME" -maxdepth 4 -type l -print0 2>/dev/null)

info "  $linked working symlinks"
[[ $broken -gt 0 ]] && error "  $broken broken symlinks"

step "GitHub signing key"
profile_signingkey_var="GIT_$(echo "${DOTFILES_PROFILE:-work}" | tr 'a-z' 'A-Z')_SIGNINGKEY"
profile_signingkey="${!profile_signingkey_var:-}"
if [[ -z "$profile_signingkey" ]]; then
  warn "  $profile_signingkey_var is empty — fnox not synced?"
elif ! has gh; then
  warn "  gh not installed"
elif ! gh auth status >/dev/null 2>&1; then
  warn "  gh not authenticated"
elif ! gh auth status 2>&1 | grep -q admin:ssh_signing_key; then
  warn "  gh missing admin:ssh_signing_key scope — run \`mise run //packages/vcs:git:sync-signing-keys\`"
else
  body="$(awk '{print $2}' <<<"$profile_signingkey")"
  if gh api user/ssh_signing_keys --jq '.[].key' 2>/dev/null \
       | awk '{print $2}' | grep -qxF "$body"; then
    info "  signing key registered with GitHub ✓"
  else
    error "  ✗ signing key NOT registered — run \`mise run //packages/vcs:git:sync-signing-keys\`"
    ((errors++))
  fi
fi

step "Secrets (fnox)"
if has fnox; then
  if fnox export --format json >/dev/null 2>&1; then
    info "  fnox resolves secrets"
  else
    warn "  fnox export failed — run \`fnox sync --provider age --config fnox.local.toml\`"
  fi
else
  warn "  fnox not installed — run \`mise install\`"
fi

step "Summary"
if [[ $errors -eq 0 ]]; then
  info "All checks passed ✓"
else
  error "$errors check(s) failed"
  exit 1
fi
