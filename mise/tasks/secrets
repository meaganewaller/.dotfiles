#!/usr/bin/env bash
#MISE description="Manage runtime API tokens (env vars from 1Password)"
#MISE alias="sec"
#USAGE flag "--refresh" help="Pull tokens from 1Password and write secrets.{env,fish}"
#USAGE flag "--print" help="Print bash exports to stdout (no files written)"
#USAGE flag "--check" help="Verify secrets files exist with correct perms"
#USAGE flag "--write <var>" help="Read value from stdin and update 1Password" default=""
#USAGE flag "--profile <profile>" default="work"
set -euo pipefail
source "$DOTFILES_ROOT/lib/common.sh"

REFRESH="${usage_refresh:-false}"
PRINT="${usage_print:-false}"
CHECK="${usage_check:-false}"
WRITE="${usage_write:-}"
PROFILE="${usage_profile:-work}"

SECRETS_DIR="${DOTFILES_SECRETS_DIR:-$HOME/.config/dotfiles}"
SECRETS_ENV="$SECRETS_DIR/secrets.env"
SECRETS_FISH="$SECRETS_DIR/secrets.fish"
MANIFEST="$DOTFILES_ROOT/vars/runtime-secrets.toml"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

require_op() {
  has op || die "1Password CLI not found. Install: https://developer.1password.com/docs/cli/"
  op whoami >/dev/null 2>&1 || die "Not signed into 1Password. Run: mise run auth"
}

toml_to_json() {
  if has dasel; then
    dasel -r toml -w json < "$1"
  elif has yq; then
    yq -p toml -o json < "$1"
  else
    python3 -c "import sys, json, tomllib; print(json.dumps(tomllib.loads(sys.stdin.read())))" < "$1"
  fi
}

# Load the manifest and emit one JSON object per line for secrets that apply
# to the current profile + OS. Each line: {env, item, field, vault}
applicable_secrets() {
  [[ -f "$MANIFEST" ]] || die "Manifest not found: $MANIFEST"

  local manifest_json
  manifest_json="$(toml_to_json "$MANIFEST")"

  echo "$manifest_json" | jq -c --arg profile "$PROFILE" --arg os "$DOTFILES_OS" '
    .secret // [] | .[] |
    # Profile filter: empty profiles array means all
    select((.profiles // []) | length == 0 or index($profile)) |
    # OS filter: empty os array means all
    select((.os // []) | length == 0 or index($os)) |
    {
      env: .env,
      item: .item,
      field: .field,
      vault: (.vault // "Private")
    }
  '
}

# Look up a single secret entry by env var name. Echoes JSON or empty.
secret_for_env() {
  local var="$1"
  [[ -f "$MANIFEST" ]] || die "Manifest not found: $MANIFEST"

  toml_to_json "$MANIFEST" | jq -c --arg var "$var" '
    .secret // [] | map(select(.env == $var)) | .[0] // empty
  '
}

# Format a value as a fish single-quoted string. Fish only requires escaping
# of \ and ' inside single quotes — no python needed.
fish_quote() {
  local val="$1"
  val="${val//\\/\\\\}"
  val="${val//\'/\\\'}"
  printf "'%s'" "$val"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_refresh() {
  require_op
  mkdir -p "$SECRETS_DIR"

  # Collect all values up front so a partial failure leaves files untouched
  local pairs=""   # tab-separated lines: <ENV>\t<value>
  local count=0 missing=0

  step "Fetching secrets for profile: $PROFILE"

  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    local env_name item field vault ref val
    env_name="$(echo "$entry" | jq -r '.env')"
    item="$(echo "$entry" | jq -r '.item')"
    field="$(echo "$entry" | jq -r '.field')"
    vault="$(echo "$entry" | jq -r '.vault')"

    ref="op://$vault/$item/$field"

    if val="$(op read "$ref" 2>/dev/null)" && [[ -n "$val" ]]; then
      pairs+="$env_name"$'\t'"$val"$'\n'
      info "  $env_name"
      ((count++))
    else
      warn "  $env_name (not found at $ref)"
      ((missing++))
    fi
  done < <(applicable_secrets)

  if [[ "$count" -eq 0 ]]; then
    die "No secrets fetched — nothing written"
  fi

  # Write secrets.env
  local tmp
  tmp="$(mktemp)"
  {
    echo "# Generated by: mise run secrets --refresh"
    echo "# Profile: $PROFILE | Generated: $(date -Iseconds)"
    echo "# DO NOT COMMIT — this file contains secrets in plaintext"
    while IFS=$'\t' read -r name value; do
      [[ -z "$name" ]] && continue
      printf 'export %s=%q\n' "$name" "$value"
    done <<<"$pairs"
  } >"$tmp"
  mv "$tmp" "$SECRETS_ENV"
  chmod 600 "$SECRETS_ENV"

  # Write secrets.fish
  tmp="$(mktemp)"
  {
    echo "# Generated by: mise run secrets --refresh"
    echo "# Profile: $PROFILE | Generated: $(date -Iseconds)"
    echo "# DO NOT COMMIT — this file contains secrets in plaintext"
    while IFS=$'\t' read -r name value; do
      [[ -z "$name" ]] && continue
      printf 'set -gx %s %s\n' "$name" "$(fish_quote "$value")"
    done <<<"$pairs"
  } >"$tmp"
  mv "$tmp" "$SECRETS_FISH"
  chmod 600 "$SECRETS_FISH"

  info "Wrote $count secret(s) to:"
  log "  $SECRETS_ENV   (bash/zsh)"
  log "  $SECRETS_FISH  (fish)"
  if [[ "$missing" -gt 0 ]]; then
    warn "$missing secret(s) skipped — see warnings above"
  fi
  log ""
  log "Open a new shell or: source $SECRETS_ENV"
}

cmd_print() {
  require_op
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    local env_name item field vault ref val
    env_name="$(echo "$entry" | jq -r '.env')"
    item="$(echo "$entry" | jq -r '.item')"
    field="$(echo "$entry" | jq -r '.field')"
    vault="$(echo "$entry" | jq -r '.vault')"

    ref="op://$vault/$item/$field"
    if val="$(op read "$ref" 2>/dev/null)" && [[ -n "$val" ]]; then
      printf 'export %s=%q\n' "$env_name" "$val"
    else
      echo "# MISSING: $env_name ($ref)" >&2
    fi
  done < <(applicable_secrets)
}

cmd_check() {
  step "Checking runtime secrets"

  local errors=0

  # Files exist?
  for f in "$SECRETS_ENV" "$SECRETS_FISH"; do
    if [[ -f "$f" ]]; then
      info "  ✓ $f exists"
    else
      error "  ✗ $f missing"
      ((errors++))
      continue
    fi

    # Mode 600?
    local mode
    mode="$(stat -f %Lp "$f" 2>/dev/null || stat -c %a "$f" 2>/dev/null)"
    if [[ "$mode" == "600" ]]; then
      info "  ✓ $f mode 600"
    else
      warn "  ! $f mode is $mode, expected 600"
      ((errors++))
    fi

    # Age check — older than 90 days = warning
    local age_days
    if [[ "$DOTFILES_OS" == "macos" ]]; then
      age_days=$(( ( $(date +%s) - $(stat -f %m "$f") ) / 86400 ))
    else
      age_days=$(( ( $(date +%s) - $(stat -c %Y "$f") ) / 86400 ))
    fi
    if [[ "$age_days" -gt 90 ]]; then
      warn "  ! $f is $age_days days old — consider rotating tokens and refreshing"
    else
      info "  ✓ $f refreshed $age_days days ago"
    fi
  done

  # Count expected vs actual env exports
  if [[ -f "$SECRETS_ENV" ]]; then
    local expected actual
    expected="$(applicable_secrets | jq -s 'length')"
    actual="$(grep -c '^export ' "$SECRETS_ENV" 2>/dev/null || echo 0)"
    if [[ "$expected" == "$actual" ]]; then
      info "  ✓ $actual of $expected secrets present"
    else
      warn "  ! $actual of $expected secrets present — run --refresh"
      ((errors++))
    fi
  fi

  if [[ "$errors" -eq 0 ]]; then
    info "Secrets OK"
  else
    error "$errors check(s) failed"
    exit 1
  fi
}

cmd_write() {
  local var="$1"
  require_op

  local entry
  entry="$(secret_for_env "$var")"
  if [[ -z "$entry" ]]; then
    local valid
    valid="$(applicable_secrets | jq -r '.env' | paste -sd, -)"
    die "Unknown variable: $var (valid: $valid)"
  fi

  local item field vault value
  item="$(echo "$entry" | jq -r '.item')"
  field="$(echo "$entry" | jq -r '.field')"
  vault="$(echo "$entry" | jq -r '.vault // "Private"')"

  value="$(cat)"
  [[ -n "$value" ]] || die "Refusing to write empty value (stdin was empty)"

  step "Updating 1Password: $vault / $item / $field"
  op item edit "$item" --vault "$vault" "${field}=${value}" >/dev/null
  info "Updated $var in 1Password"
  log ""
  log "Refresh local files with: mise run secrets --refresh"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
  # Exactly one mode flag must be set
  local modes=0
  [[ "$REFRESH" == "true" ]] && ((modes++)) || true
  [[ "$PRINT"   == "true" ]] && ((modes++)) || true
  [[ "$CHECK"   == "true" ]] && ((modes++)) || true
  [[ -n "$WRITE" ]]          && ((modes++)) || true

  if [[ "$modes" -eq 0 ]]; then
    # Default to refresh — matches the original script's behavior
    REFRESH="true"
  elif [[ "$modes" -gt 1 ]]; then
    die "Pick one of: --refresh, --print, --check, --write VAR"
  fi

  if [[ "$REFRESH" == "true" ]]; then
    cmd_refresh
  elif [[ "$PRINT" == "true" ]]; then
    cmd_print
  elif [[ "$CHECK" == "true" ]]; then
    cmd_check
  elif [[ -n "$WRITE" ]]; then
    cmd_write "$WRITE"
  fi
}

main
