#!/usr/bin/env bash
#MISE description="Full setup for a profile"
#MISE alias="s"
#USAGE flag "--profile <profile>" help="Profile to apply"
#USAGE flag "--only <packages>"
#USAGE flag "--dry-run" help="Don't write anything"
#USAGE flag "--skip-auth" help="Skip gh/op signin"
#USAGE flag "--skip-brew" help="Skip homebrew bundle"
set -euo pipefail
source "$DOTFILES_ROOT/lib/common.sh"

PROFILE="${usage_profile:-${DOTFILES_PROFILE:-work}}"
ONLY="${usage_only:-}"
DRY_RUN="${usage_dry_run:-false}"
SKIP_AUTH="${usage_skip_auth:-false}"
SKIP_BREW="${usage_skip_brew:-false}"

validate_profile "$PROFILE"
export DOTFILES_PROFILE="$PROFILE"
export MISE_ENV="$PROFILE"
export DOTFILES_DRY_RUN=$([[ "$DRY_RUN" == "true" ]] && echo 1 || echo 0)

step "Setting up profile: $PROFILE"

# Order matters:
# 1. deps    → curl, git, gh, op (the things mise won't manage)
# 2. auth    → needs gh + op binaries
# 3. link    → symlinks dotfiles BEFORE mise install so MISE_ENV layers resolve
# 4. install → mise picks up profile tools
# 5. secrets → needs auth + tools to pull secrets from 1Password
# 6. brew    → uses profile's brew_layers
# 7. fonts   → purely cosmetic, so run last

# Propagate dry-run to all child tasks via env. Each task picks this up
# as a fallback when --dry-run isn't passed explicitly.
if [[ "$DRY_RUN" == "true" ]]; then
  export DOTFILES_DRY_RUN=1
else
  unset DOTFILES_DRY_RUN
fi

dry_run_banner "$DRY_RUN"
step "Setting up profile: $PROFILE"

mise run deps

# Build link args — only forward flags that aren't dry-run (env handles that)
link_args=(--profile "$PROFILE")
[[ -n "$ONLY" ]] && link_args+=(--only "$ONLY")
mise run link "${link_args[@]}"

# mise install doesn't really have a meaningful dry-run mode,
# but skip it if we're previewing
if [[ "$DRY_RUN" != "true" ]]; then
  mise install
else
  dry "Would run: mise install"
fi

if [[ "$SKIP_AUTH" != "true" ]]; then
  if [[ "$DRY_RUN" == "true" ]]; then
    dry "Would run: mise run auth"
    dry "Would run: fnox sync --provider age --config fnox.local.toml"
    dry "Would run: mise run //packages/vcs:git:sync-signing-keys"
  else
    mise run auth
    if has fnox; then
      fnox sync --provider age --config fnox.local.toml --force \
        || warn "fnox sync failed — see ADR 0005 for first-time setup"
    else
      warn "fnox not on PATH — secrets will not resolve until \`mise install\` runs"
    fi
    # Register this profile's SSH signing key with GitHub so commits show
    # Verified. Runs after fnox sync so $GIT_*_SIGNINGKEY is populated.
    mise run //packages/vcs:git:sync-signing-keys -- --profile "$PROFILE" \
      || warn "git signing key registration failed — commits may show as Unverified on GitHub"
  fi
fi

if [[ "$SKIP_BREW" != "true" ]]; then
	if [[ "$DRY_RUN" == "true" ]]; then
		dry "Would run: mise run brew --profile $PROFILE"
		dry "Would run: mise run fonts"
	else
		mise run brew --profile "$PROFILE"
		mise run fonts
	fi
fi

info "Setup complete"
dry_run_banner "$DRY_RUN"
