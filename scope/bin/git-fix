#!/usr/bin/env bash
set -euo pipefail

PROFILE="${DOTFILES_PROFILE:-work}"

echo "[git-fix] Profile: ${PROFILE}"

# 1) Ensure git is installed
if ! command -v git >/dev/null 2>&1; then
  echo "[git-fix] git not found, attempting to install..."

  if command -v brew >/dev/null 2>&1; then
    brew install git
  elif command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y git
  elif command -v yum >/dev/null 2>&1; then
    sudo yum install -y git
  else
    echo "[git-fix] No supported package manager found for git install." >&2
    exit 1
  fi

  if ! command -v git >/dev/null 2>&1; then
    echo "[git-fix] git install appears to have failed." >&2
    exit 1
  fi
fi

# 2) Set identity per profile
case "$PROFILE" in
  work)
    echo "[git-fix] Setting global git identity to WORK"
    git config --global user.name  "Meagan Waller"
    git config --global user.email "meagan.waller@gusto.com"
    ;;
  personal)
    echo "[git-fix] Setting global git identity to PERSONAL"
    git config --global user.name  "Meagan Waller"
    git config --global user.email "meagan@meaganwaller.com"
    ;;
  server)
    echo "[git-fix] Server profile: not enforcing a global git identity."
    ;;
  *)
    echo "[git-fix] Unknown profile '${PROFILE}', not changing git identity."
    ;;
esac

exit 0

