#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="doctor-ssh"

usage() {
  echo "Usage: ${SCRIPT_NAME} {check|fix}" >&2
}

check_ssh() {
  local profile="${DOTFILES_PROFILE:-work}"

  if [ ! -d "$HOME/.ssh" ]; then
    return 1
  fi

  if [ ! -e "$HOME/.ssh/config" ]; then
    return 1
  fi

  case "$profile" in
    work)
      if [ ! -f "$HOME/.ssh/id_ed25519_work" ]; then
        return 1
      fi
      ;;
    personal)
      if [ ! -f "$HOME/.ssh/id_ed25519_personal" ]; then
        return 1
      fi
      ;;
    server)
      ;;
    *)
      ;;
  esac

  return 0
}

fix_ssh() {
  local dotfiles_root="${DOTFILES_ROOT:-$HOME/.dotfiles}"
  local profile="${DOTFILES_PROFILE:-work}"

  echo "[${SCRIPT_NAME}] DOTFILES_ROOT=${dotfiles_root}"
  echo "[${SCRIPT_NAME}] DOTFILES_PROFILE=${profile}"

  backup_if_exists() {
    local target="$1"
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      local backup="${target}.backup.$(date +%s)"
      echo "[${SCRIPT_NAME}] Backing up ${target} -> ${backup}"
      mv "$target" "$backup"
    fi
  }

  if [ ! -d "$HOME/.ssh" ]; then
    echo "[${SCRIPT_NAME}] Creating ~/.ssh directory"
    mkdir -p "$HOME/.ssh"
  fi
  chmod 700 "$HOME/.ssh"

  local dotfiles_ssh_dir="${dotfiles_root}/home/.ssh"

  if [ -d "$dotfiles_ssh_dir" ]; then
    if [ -f "${dotfiles_ssh_dir}/config" ]; then
      backup_if_exists "$HOME/.ssh/config"
      ln -sf "${dotfiles_ssh_dir}/config" "$HOME/.ssh/config"
      echo "[${SCRIPT_NAME}] Linked ~/.ssh/config -> ${dotfiles_ssh_dir}/config"
    fi

    if [ -f "${dotfiles_ssh_dir}/config.work" ]; then
      ln -sf "${dotfiles_ssh_dir}/config.work" "$HOME/.ssh/config.work"
      echo "[${SCRIPT_NAME}] Linked ~/.ssh/config.work"
    fi

    if [ -f "${dotfiles_ssh_dir}/config.personal" ]; then
      ln -sf "${dotfiles_ssh_dir}/config.personal" "$HOME/.ssh/config.personal"
      echo "[${SCRIPT_NAME}] Linked ~/.ssh/config.personal"
    fi
  else
    echo "[${SCRIPT_NAME}] WARNING: ${dotfiles_ssh_dir} does not exist; skipping config linking." >&2
  fi

  case "$profile" in
    work)
      if [ ! -f "$HOME/.ssh/id_ed25519_work" ]; then
        echo "[${SCRIPT_NAME}] Generating work SSH key: ~/.ssh/id_ed25519_work"
        ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519_work" -C "meagan.work@example.com" -N ""
      fi
      ;;
    personal)
      if [ ! -f "$HOME/.ssh/id_ed25519_personal" ]; then
        echo "[${SCRIPT_NAME}] Generating personal SSH key: ~/.ssh/id_ed25519_personal"
        ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519_personal" -C "meagan.personal@example.com" -N ""
      fi
      ;;
    server)
      echo "[${SCRIPT_NAME}] Server profile: not generating named keys automatically."
      ;;
    *)
      echo "[${SCRIPT_NAME}] Unknown profile '${profile}', not auto-generating keys."
      ;;
  esac

  for key in \
    "$HOME/.ssh/id_ed25519" \
    "$HOME/.ssh/id_ed25519.pub" \
    "$HOME/.ssh/id_ed25519_work" \
    "$HOME/.ssh/id_ed25519_work.pub" \
    "$HOME/.ssh/id_ed25519_personal" \
    "$HOME/.ssh/id_ed25519_personal.pub"
  do
    if [ -f "$key" ]; then
      chmod 600 "$key" 2>/dev/null || true
    fi
  done

  echo "[${SCRIPT_NAME}] SSH setup complete."
}

main() {
  local cmd="${1:-}"

  if [ $# -gt 0 ]; then
    shift
  fi

  case "$cmd" in
    check)
      check_ssh "$@"
      ;;
    fix)
      fix_ssh "$@"
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
