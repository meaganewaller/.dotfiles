#!/usr/bin/env bash
set -euo pipefail

# Exit 0 if:
#   - not macOS (we don't care), OR
#   - brew is installed
# Exit 1 if we're on macOS and brew is missing.

if [ "$(uname -s)" != "Darwin" ]; then
  # Non-macOS: treat as "nothing to do"
  exit 0
fi

if command -v brew >/dev/null 2>&1; then
  exit 0
else
  exit 1
fi

