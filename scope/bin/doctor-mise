#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="doctor-mise"

usage() {
  echo "Usage: ${SCRIPT_NAME} {check|fix}" >&2
}

check_mise() {
  local dotfiles_root="${DOTFILES_ROOT:-$HOME/.dotfiles}"

  if ! command -v mise >/dev/null 2>&1; then
    return 1
  fi

  local mise_config="${HOME}/.config/mise/config.toml"
  local dotfiles_mise_config="${dotfiles_root}/mise/config.toml"

  if [ -f "$dotfiles_mise_config" ] && [ ! -f "$mise_config" ]; then
    return 1
  fi

  if [ ! -f "$dotfiles_mise_config" ] && [ ! -f "$mise_config" ]; then
    return 1
  fi

  return 0
}

fix_mise() {
  local dotfiles_root="${DOTFILES_ROOT:-$HOME/.dotfiles}"
  local profile="${DOTFILES_PROFILE:-work}"

  echo "[${SCRIPT_NAME}] DOTFILES_ROOT=${dotfiles_root}"
  echo "[${SCRIPT_NAME}] DOTFILES_PROFILE=${profile}"

  local mise_config_dir="${HOME}/.config/mise"
  local mise_config="${mise_config_dir}/config.toml"
  local dotfiles_mise_config="${dotfiles_root}/mise/config.toml"

  backup_if_exists() {
    local target="$1"
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      local backup="${target}.backup.$(date +%s)"
      echo "[${SCRIPT_NAME}] Backing up ${target} -> ${backup}"
      mv "$target" "$backup"
    fi
  }

  if ! command -v mise >/dev/null 2>&1; then
    echo "[${SCRIPT_NAME}] mise not found — installing"

    if command -v brew >/dev/null 2>&1; then
      brew install mise
    else
      echo "[${SCRIPT_NAME}] Installing via official script"
      curl https://mise.run | sh
      export PATH="${HOME}/.local/bin:${PATH}"
    fi

    if ! command -v mise >/dev/null 2>&1; then
      echo "[${SCRIPT_NAME}] mise install failed!" >&2
      return 1
    fi
  fi

  mkdir -p "$mise_config_dir"

  if [ -f "$dotfiles_mise_config" ]; then
    echo "[${SCRIPT_NAME}] Syncing mise config"
    backup_if_exists "$mise_config"
    cp "$dotfiles_mise_config" "$mise_config"
  else
    echo "[${SCRIPT_NAME}] No config.toml found in ${dotfiles_root}/mise/ — skipping copy"
  fi

  if [ -f "$mise_config" ]; then
    echo "[${SCRIPT_NAME}] Running 'mise install'"
    mise install
  else
    echo "[${SCRIPT_NAME}] No mise config.toml present — nothing to install" >&2
  fi

  echo "[${SCRIPT_NAME}] Done"
}

main() {
  local cmd="${1:-}"

  if [ $# -gt 0 ]; then
    shift
  fi

  case "$cmd" in
    check)
      check_mise "$@"
      ;;
    fix)
      fix_mise "$@"
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
