#!/usr/bin/env bash
set -euo pipefail

DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/.dotfiles}"
PROFILE="${DOTFILES_PROFILE:-work}"

echo "[mise-fix] DOTFILES_ROOT=${DOTFILES_ROOT}"
echo "[mise-fix] DOTFILES_PROFILE=${PROFILE}"

MiseConfigDir="${HOME}/.config/mise"
MiseConfig="${MiseConfigDir}/config.toml"
DotfilesMiseConfig="${DOTFILES_ROOT}/mise/config.toml"

backup_if_exists() {
  local target="$1"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    local backup="${target}.backup.$(date +%s)"
    echo "[mise-fix] Backing up ${target} -> ${backup}"
    mv "$target" "$backup"
  fi
}

###############################################################################
# 1. Ensure mise is installed
###############################################################################
if ! command -v mise >/dev/null 2>&1; then
  echo "[mise-fix] mise not found — installing"

  if command -v brew >/dev/null 2>&1; then
    brew install mise
  else
    echo "[mise-fix] Installing via official script"
    curl https://mise.run | sh
    export PATH="${HOME}/.local/bin:${PATH}"
  fi

  if ! command -v mise >/dev/null 2>&1; then
    echo "[mise-fix] mise install failed!" >&2
    exit 1
  fi
fi

###############################################################################
# 2. Sync dotfiles/mise/config.toml -> ~/.config/mise/config.toml
###############################################################################
mkdir -p "$MiseConfigDir"

if [ -f "$DotfilesMiseConfig" ]; then
  echo "[mise-fix] Syncing mise config"
  backup_if_exists "$MiseConfig"
  cp "$DotfilesMiseConfig" "$MiseConfig"
else
  echo "[mise-fix] No config.toml found in ${DOTFILES_ROOT}/mise/ — skipping copy"
fi

###############################################################################
# 3. Install tools
###############################################################################
if [ -f "$MiseConfig" ]; then
  echo "[mise-fix] Running 'mise install'"
  mise install
else
  echo "[mise-fix] No mise config.toml present — nothing to install" >&2
fi

echo "[mise-fix] Done"

