#!/usr/bin/env bash
set -euo pipefail

PROFILE="${DOTFILES_PROFILE:-work}"

# 1) ~/.ssh must exist and be a directory
if [ ! -d "$HOME/.ssh" ]; then
  exit 1
fi

# 2) ~/.ssh/config should exist (file OR symlink)
if [ ! -e "$HOME/.ssh/config" ]; then
  # we consider this a failure so fix can link it in
  exit 1
fi

# 3) Profile-specific keys
case "$PROFILE" in
  work)
    # require work key
    if [ ! -f "$HOME/.ssh/id_ed25519_work" ]; then
      exit 1
    fi
    ;;
  personal)
    # require personal key
    if [ ! -f "$HOME/.ssh/id_ed25519_personal" ]; then
      exit 1
    fi
    ;;
  server)
    # For server profile, don't enforce key naming convention
    ;;
  *)
    # Unknown profile -> be lenient
    ;;
esac

# If we made it here, checks passed
exit 0

