#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="doctor-homebrew"

usage() {
  echo "Usage: ${SCRIPT_NAME} {check|fix}" >&2
}

check_homebrew() {
  if [ "$(uname -s)" != "Darwin" ]; then
    return 0
  fi

  if command -v brew >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

fix_homebrew() {
  if [ "$(uname -s)" != "Darwin" ]; then
    echo "[${SCRIPT_NAME}] Not macOS; nothing to do." >&2
    return 0
  fi

  if command -v brew >/dev/null 2>&1; then
    echo "[${SCRIPT_NAME}] Homebrew already installed."
    return 0
  fi

  echo "[${SCRIPT_NAME}] Installing Homebrew..."

  # Official Homebrew installer
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Try to wire it into the current shell env so subsequent steps can use brew
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi

  if ! command -v brew >/dev/null 2>&1; then
    echo "[${SCRIPT_NAME}] Brew install appears to have failed or brew not on PATH." >&2
    return 1
  fi

  echo "[${SCRIPT_NAME}] Homebrew installed at $(command -v brew)"
}

main() {
  local cmd="${1:-}"

  if [ $# -gt 0 ]; then
    shift
  fi

  case "$cmd" in
    check)
      check_homebrew "$@"
      ;;
    fix)
      fix_homebrew "$@"
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
