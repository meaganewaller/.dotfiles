#!/usr/bin/env bash
set -euo pipefail

DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/.dotfiles}"
PROFILE="${DOTFILES_PROFILE:-work}"

echo "[ssh-fix] DOTFILES_ROOT=${DOTFILES_ROOT}"
echo "[ssh-fix] DOTFILES_PROFILE=${PROFILE}"

# Helper: backup non-symlink files
backup_if_exists() {
  local target="$1"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    local backup="${target}.backup.$(date +%s)"
    echo "[ssh-fix] Backing up ${target} -> ${backup}"
    mv "$target" "$backup"
  fi
}

# 1) Ensure ~/.ssh exists with correct perms
if [ ! -d "$HOME/.ssh" ]; then
  echo "[ssh-fix] Creating ~/.ssh directory"
  mkdir -p "$HOME/.ssh"
fi
chmod 700 "$HOME/.ssh"

# 2) Link config files from dotfiles, if present
DOTFILES_SSH_DIR="${DOTFILES_ROOT}/home/.ssh"

if [ -d "$DOTFILES_SSH_DIR" ]; then
  # Main config
  if [ -f "${DOTFILES_SSH_DIR}/config" ]; then
    backup_if_exists "$HOME/.ssh/config"
    ln -sf "${DOTFILES_SSH_DIR}/config" "$HOME/.ssh/config"
    echo "[ssh-fix] Linked ~/.ssh/config -> ${DOTFILES_SSH_DIR}/config"
  fi

  # Profile-specific configs (optional)
  if [ -f "${DOTFILES_SSH_DIR}/config.work" ]; then
    ln -sf "${DOTFILES_SSH_DIR}/config.work" "$HOME/.ssh/config.work"
    echo "[ssh-fix] Linked ~/.ssh/config.work"
  fi

  if [ -f "${DOTFILES_SSH_DIR}/config.personal" ]; then
    ln -sf "${DOTFILES_SSH_DIR}/config.personal" "$HOME/.ssh/config.personal"
    echo "[ssh-fix] Linked ~/.ssh/config.personal"
  fi
else
  echo "[ssh-fix] WARNING: ${DOTFILES_SSH_DIR} does not exist; skipping config linking." >&2
fi

# 3) Generate keys per profile if missing
case "$PROFILE" in
  work)
    if [ ! -f "$HOME/.ssh/id_ed25519_work" ]; then
      echo "[ssh-fix] Generating work SSH key: ~/.ssh/id_ed25519_work"
      ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519_work" -C "meagan.work@example.com" -N ""
    fi
    ;;
  personal)
    if [ ! -f "$HOME/.ssh/id_ed25519_personal" ]; then
      echo "[ssh-fix] Generating personal SSH key: ~/.ssh/id_ed25519_personal"
      ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519_personal" -C "meagan.personal@example.com" -N ""
    fi
    ;;
  server)
    echo "[ssh-fix] Server profile: not generating named keys automatically."
    ;;
  *)
    echo "[ssh-fix] Unknown profile '${PROFILE}', not auto-generating keys."
    ;;
esac

# 4) Fix permissions on keys if they exist
for key in \
  "$HOME/.ssh/id_ed25519" \
  "$HOME/.ssh/id_ed25519.pub" \
  "$HOME/.ssh/id_ed25519_work" \
  "$HOME/.ssh/id_ed25519_work.pub" \
  "$HOME/.ssh/id_ed25519_personal" \
  "$HOME/.ssh/id_ed25519_personal.pub"
do
  if [ -f "$key" ]; then
    chmod 600 "$key" 2>/dev/null || true
  fi
done

echo "[ssh-fix] SSH setup complete."

