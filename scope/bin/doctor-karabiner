#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="doctor-karabiner"

usage() {
  echo "Usage: ${SCRIPT_NAME} {check|fix}" >&2
}

check_karabiner() {
  if [ "$(uname -s)" != "Darwin" ]; then
    return 0
  fi

  if command -v karabiner_cli >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

fix_karabiner() {
  if [ "$(uname -s)" != "Darwin" ]; then
    echo "[${SCRIPT_NAME}] Not macOS; nothing to do." >&2
    return 0
  fi

  if command -v karabiner_cli >/dev/null 2>&1; then
    echo "[${SCRIPT_NAME}] Karabiner-Elements already installed."
    return 0
  fi

  echo "[${SCRIPT_NAME}] Installing Karabiner-Elements..."
  brew install --cask karabiner-elements
}

main() {
  local cmd="${1:-}"

  if [ $# -gt 0 ]; then
    shift
  fi

  case "$cmd" in
    check)
      check_karabiner "$@"
      ;;
    fix)
      fix_karabiner "$@"
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
