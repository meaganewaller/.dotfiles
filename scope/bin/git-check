#!/usr/bin/env bash
set -euo pipefail

PROFILE="${DOTFILES_PROFILE:-work}"

# 1) Git must exist
if ! command -v git >/dev/null 2>&1; then
  # missing git = fail
  exit 1
fi

# 2) Global identity should match profile (except server, which we ignore)
expected_email=""

case "$PROFILE" in
  work)
    expected_email="meagan.waller@gusto.com"
    ;;
  personal)
    expected_email="meagan@meaganwaller.com"
    ;;
  server)
    # For servers, we don't enforce a global identity
    exit 0
    ;;
  *)
    # Unknown profile? don't enforce identity
    exit 0
    ;;
esac

current_email="$(git config --global user.email || echo "")"

if [ "$current_email" = "$expected_email" ]; then
  exit 0
else
  # mismatch = fail so fix will run
  exit 1
fi

