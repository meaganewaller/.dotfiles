#!/usr/bin/env bash
set -euo pipefail

DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/.dotfiles}"

# 1) mise CLI must exist
if ! command -v mise >/dev/null 2>&1; then
  exit 1
fi

# 2) Global config should exist somewhere
MiseConfig="${HOME}/.config/mise/config.toml"
DotfilesMiseConfig="${DOTFILES_ROOT}/mise/config.toml"

if [ -f "$DotfilesMiseConfig" ] && [ ! -f "$MiseConfig" ]; then
  # we have a config in dotfiles but not in ~/.config/mise -> fix needed
  exit 1
fi

# If neither exists, that's also a failure: we want *some* config.
if [ ! -f "$DotfilesMiseConfig" ] && [ ! -f "$MiseConfig" ]; then
  exit 1
fi

# 3) Optional: if config exists, we assume `mise install` is idempotent and cheap,
# so we don't try to be clever about whether everything is installed—fix will just
# run `mise install` again if you force it.

exit 0

