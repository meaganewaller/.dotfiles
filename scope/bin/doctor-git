#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="doctor-git"

usage() {
  echo "Usage: ${SCRIPT_NAME} {check|fix}" >&2
}

check_git() {
  local profile="${DOTFILES_PROFILE:-work}"

  if ! command -v git >/dev/null 2>&1; then
    return 1
  fi

  local expected_email=""

  case "$profile" in
    work)
      expected_email="meagan.waller@gusto.com"
      ;;
    personal)
      expected_email="meagan@meaganwaller.com"
      ;;
    server)
      return 0
      ;;
    *)
      return 0
      ;;
  esac

  local current_email
  current_email="$(git config --global user.email || echo "")"

  if [ "$current_email" = "$expected_email" ]; then
    return 0
  fi

  return 1
}

fix_git() {
  local profile="${DOTFILES_PROFILE:-work}"

  echo "[${SCRIPT_NAME}] Profile: ${profile}"

  if ! command -v git >/dev/null 2>&1; then
    echo "[${SCRIPT_NAME}] git not found, attempting to install..."

    if command -v brew >/dev/null 2>&1; then
      brew install git
    elif command -v apt-get >/dev/null 2>&1; then
      sudo apt-get update
      sudo apt-get install -y git
    elif command -v yum >/dev/null 2>&1; then
      sudo yum install -y git
    else
      echo "[${SCRIPT_NAME}] No supported package manager found for git install." >&2
      return 1
    fi

    if ! command -v git >/dev/null 2>&1; then
      echo "[${SCRIPT_NAME}] git install appears to have failed." >&2
      return 1
    fi
  fi

  case "$profile" in
    work)
      echo "[${SCRIPT_NAME}] Setting global git identity to WORK"
      git config --global user.name  "Meagan Waller"
      git config --global user.email "meagan.waller@gusto.com"
      ;;
    personal)
      echo "[${SCRIPT_NAME}] Setting global git identity to PERSONAL"
      git config --global user.name  "Meagan Waller"
      git config --global user.email "meagan@meaganwaller.com"
      ;;
    server)
      echo "[${SCRIPT_NAME}] Server profile: not enforcing a global git identity."
      ;;
    *)
      echo "[${SCRIPT_NAME}] Unknown profile '${profile}', not changing git identity."
      ;;
  esac
}

main() {
  local cmd="${1:-}"

  if [ $# -gt 0 ]; then
    shift
  fi

  case "$cmd" in
    check)
      check_git "$@"
      ;;
    fix)
      fix_git "$@"
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
