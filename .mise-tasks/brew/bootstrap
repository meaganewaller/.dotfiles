#!/usr/bin/env bash
#MISE description="Install brew layers and detect drift"
#MISE alias="brew:bootstrap"

set -euo pipefail

if ! command -v brew >/dev/null; then
  echo "Homebrew not installed."
  exit 1
fi

LAYERS="${BREW_LAYERS:-base}"

echo "==> Installing Brew layers: $LAYERS"
echo

for layer in $LAYERS; do
  FILE="brewfiles/${layer}.Brewfile"

  if [[ ! -f "$FILE" ]]; then
    echo "Layer not found: $FILE"
    exit 1
  fi

  echo "→ Installing layer: $layer"
  brew bundle --file="$FILE"
done

echo
echo "==> Checking for Brew drift..."
echo

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

DECLARED_FORMULAE="$TMP_DIR/declared.formulae"
DECLARED_CASKS="$TMP_DIR/declared.casks"
ACTUAL_FORMULAE="$TMP_DIR/actual.formulae"
ACTUAL_CASKS="$TMP_DIR/actual.casks"

# Brewfile entries can be tap-qualified (e.g. owner/tap/name),
# while brew list outputs canonical tokens (e.g. name).
normalize_brew_token() {
  local raw="$1"
  printf '%s\n' "${raw##*/}"
}

# ----------------------------------------
# Collect declared formulae & casks
# ----------------------------------------

> "$DECLARED_FORMULAE"
> "$DECLARED_CASKS"

for layer in $LAYERS; do
  FILE="brewfiles/${layer}.Brewfile"

  echo "→ Processing layer: $layer"

  grep -E '^brew ' "$FILE" \
    | awk '{print $2}' \
    | tr -d '"' \
    | while IFS= read -r entry; do
        normalize_brew_token "$entry"
      done \
    >> "$DECLARED_FORMULAE" || true

  grep -E '^cask ' "$FILE" \
      | awk '{print $2}' \
      | tr -d '"' \
      | while IFS= read -r entry; do
          normalize_brew_token "$entry"
        done \
      >> "$DECLARED_CASKS" || true
done

sort -u "$DECLARED_FORMULAE" -o "$DECLARED_FORMULAE"
sort -u "$DECLARED_CASKS" -o "$DECLARED_CASKS"

# ----------------------------------------
# Collect actual installed
# ----------------------------------------

brew leaves \
  | while IFS= read -r entry; do
      normalize_brew_token "$entry"
    done \
  | sort -u > "$ACTUAL_FORMULAE"

brew list --cask \
  | while IFS= read -r entry; do
      normalize_brew_token "$entry"
    done \
  | sort -u > "$ACTUAL_CASKS"

echo
echo "==> Evaluating drift..."

# ----------------------------------------
# Compute differences (formulae)
# ----------------------------------------

EXTRA_FORMULAE="$TMP_DIR/extra.formulae"
MISSING_FORMULAE="$TMP_DIR/missing.formulae"

comm -23 "$ACTUAL_FORMULAE" "$DECLARED_FORMULAE" > "$EXTRA_FORMULAE"
comm -13 "$ACTUAL_FORMULAE" "$DECLARED_FORMULAE" > "$MISSING_FORMULAE"

# ----------------------------------------
# Compute differences (casks)
# ----------------------------------------

EXTRA_CASKS="$TMP_DIR/extra.casks"
MISSING_CASKS="$TMP_DIR/missing.casks"

comm -23 "$ACTUAL_CASKS" "$DECLARED_CASKS" > "$EXTRA_CASKS"
comm -13 "$ACTUAL_CASKS" "$DECLARED_CASKS" > "$MISSING_CASKS"

FORMULA_DRIFT=0
CASK_DRIFT=0

if [[ -s "$EXTRA_FORMULAE" || -s "$MISSING_FORMULAE" ]]; then
  FORMULA_DRIFT=1
fi

if [[ -s "$EXTRA_CASKS" || -s "$MISSING_CASKS" ]]; then
  CASK_DRIFT=1
fi

echo

if [[ "$FORMULA_DRIFT" -eq 1 ]]; then
  echo "⚠️  FORMULA DRIFT DETECTED"
  echo

  if [[ -s "$EXTRA_FORMULAE" ]]; then
    echo "  Extra installed (not declared):"
    sed 's/^/    - /' "$EXTRA_FORMULAE"
    echo
  fi

  if [[ -s "$MISSING_FORMULAE" ]]; then
    echo "  Declared but not installed:"
    sed 's/^/    - /' "$MISSING_FORMULAE"
    echo
  fi
else
  echo "✓ Formulae match declared state."
fi

if [[ "$CASK_DRIFT" -eq 1 ]]; then
  echo "⚠️  CASK DRIFT DETECTED"
  echo

  if [[ -s "$EXTRA_CASKS" ]]; then
    echo "  Extra installed (not declared):"
    sed 's/^/    - /' "$EXTRA_CASKS"
    echo
  fi

  if [[ -s "$MISSING_CASKS" ]]; then
    echo "  Declared but not installed:"
    sed 's/^/    - /' "$MISSING_CASKS"
    echo
  fi
else
  echo "✓ Casks match declared state."
fi

echo

if [[ "$FORMULA_DRIFT" -ne 0 || "$CASK_DRIFT" -ne 0 ]]; then
  echo "Drift detected. Machine diverges from declared Brewfiles."
  exit 1
fi

echo "✓ Brew state matches declaration."
