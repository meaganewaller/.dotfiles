# ============================================================
# Layer: gui
#
# Scope:
# - Core desktop UX apps
# - Terminal emulator
# - Security apps (1Password, etc.)
# - Window management
#
# Excludes:
# - Dev infra tools
# - Creative suite apps
#
# This layer makes the machine usable as a daily driver.
# ============================================================

# Terminal
cask "wezterm"

# App launcher
cask "raycast"

# Security
cask "1password"
cask "1password-cli"
cask "little-snitch"

# Window management
tap "nikitabobko/tap"
cask "aerospace"
