# ============================================================
# Layer: gui
#
# Scope:
# - Core desktop UX apps
# - Terminal emulator
# - Security apps (1Password, etc.)
# - Window management
#
# Excludes:
# - Dev infra tools
# - Creative suite apps
#
# This layer makes the machine usable as a daily driver.
# ============================================================

# Terminal
cask "wezterm@nightly"
cask "ghostty"

# Browsers
cask "chromium"
cask "google-chrome"

# App launcher
cask "raycast"

# Security
cask "1password"
cask "1password-cli"
cask "little-snitch"
cask "cloudflare-warp"

# Window management
cask "loop"
tap "nikitabobko/tap"
cask "nikitabobko/tap/aerospace"

# Tools
cask "fantastical"
cask "cameracontroller"
cask "karabiner-elements"
cask "hammerspoon"
brew "felixkratz/formulae/sketchybar"
brew "felixkratz/formulae/borders"

# Useful Apps
cask "notion"
cask "obsidian"
