#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

ICON_FONT="VictorMono Nerd Font Mono:Bold:17.0"
ITALIC_FONT="VictorMono Nerd Font Mono:Italic:17.0"
REGULAR_FONT="BigBlueTerm437 Nerd Font Mono:Regular:13.0"

# Reset
sketchybar --remove '/.*/'

# Bar
sketchybar --bar \
  color=$BAR_BG \
  blur_radius=50 \
  height=32 \
  margin=10 \
  corner_radius=6 \
  y_offset=6 \
  padding_left=10 \
  padding_right=10 \
  border_width=0

# Default styling
sketchybar --default \
  background.padding_left=5 \
  background.padding_right=5 \
  icon.padding_right=5 \
  icon.font="$ICON_FONT" \
  icon.color=$TEXT \
  label.font="$REGULAR_FONT" \
  label.color=$TEXT

# ------------------------------------------------------------
# LEFT: Front App
# ------------------------------------------------------------

sketchybar --add item front_app left \
           --set front_app \
             icon="$ICON_APP" \
             icon.font="sketchybar-app-font:Regular:17.0" \
             update_freq=2 \
             script="$PLUGIN_DIR/front_app.sh"

# ------------------------------------------------------------
# CENTER: Current Media
# ------------------------------------------------------------

sketchybar --add item media center \
           --set media \
             drawing=off \
             update_freq=3 \
             script="$PLUGIN_DIR/media.sh" \
             label.max_chars=60

# ------------------------------------------------------------
# RIGHT: The rest (ordered as you asked, grouped sanely)
# ------------------------------------------------------------

# Clock
sketchybar --add item clock right \
           --set clock \
             icon="$ICON_CLOCK" \
             update_freq=10 \
             script="$PLUGIN_DIR/clock.sh"

# Battery
sketchybar --add item battery right \
           --set battery \
             icon="$ICON_BATTERY" \
             update_freq=30 \
             script="$PLUGIN_DIR/battery.sh"

# VPN
sketchybar --add item vpn right \
           --set vpn \
             icon.font="$ICON_FONT" \
             icon="$ICON_UNLOCK" \
             update_freq=5 \
             script="$PLUGIN_DIR/vpn.sh" \
             popup.align=right \
           --subscribe vpn mouse.entered mouse.exited

# Popup content (hidden unless hovered)
sketchybar --add item vpn.popup popup.vpn \
           --set vpn.popup \
             label="VPN Status" \
             icon.drawing=off \
             background.color=$BAR_BG \
             background.height=24

# Volume
sketchybar --add item volume right \
           --set volume \
             icon="$ICON_VOLUME" \
             update_freq=2 \
             script="$PLUGIN_DIR/volume.sh"

sketchybar --set battery icon.color=$C_BATTERY
sketchybar --set clock icon.color=$C_CLOCK
sketchybar --set vpn icon.color=$C_MEDIA
sketchybar --set volume icon.color=$C_VOLUME

# ------------------------------------------------------------
# EVENTS: Theme change support
# ------------------------------------------------------------

sketchybar --add event theme_changed

sketchybar --add item theme_handler right \
           --set theme_handler \
             drawing=off \
             script="$PLUGIN_DIR/theme.sh" \
           --subscribe theme_handler theme_changed

# Apply current theme colors on startup
"$PLUGIN_DIR/theme.sh"

sketchybar --update
