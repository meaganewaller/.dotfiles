#!/usr/bin/env bash
set -euo pipefail

FONT="VictorMono Nerd Font Mono:Bold:17.0"
ICON_FONT="$FONT"
REGULAR_FONT="BigBlueTerm437 Nerd Font Mono:Regular:13.0"

export FONT

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# shellcheck source=/dev/null
source "$CONFIG_DIR/colors.sh"

# shellcheck source=/dev/null
source "$CONFIG_DIR/icons.sh"

# Reset
sketchybar --remove '/.*/'

# Bar
sketchybar --bar \
  position=top \
  color="$BAR_BG" \
  blur_radius=50 \
  height=40 \
  margin=10 \
  corner_radius=6 \
  y_offset=6 \
  padding_left=10 \
  padding_right=10 \
  border_width=0

# Default styling
sketchybar --default \
  background.padding_left=5 \
  background.padding_right=5 \
  icon.padding_right=5 \
  icon.font="$ICON_FONT" \
  icon.color="$SUBTEXT" \
  label.font="$REGULAR_FONT" \
  label.color="$TEXT" \
  label.padding_left=2 \
  label.padding_right=2 \
  icon.padding_left=2 \
  icon.padding_right=2 \
  updates=on

# ------------------------------------------------------------
# Adding Aerospace Layouts
# ------------------------------------------------------------
sketchybar --add event aerospace_workspace_change

# Add workspaces for all monitors
for monitor in $(aerospace list-monitors --format "%{monitor-appkit-nsscreen-screens-id}"); do
  for sid in $(aerospace list-workspaces --monitor "$monitor"); do
    # Determine which display this workspace should be shown on
    display_id="1"

    if [ "$sid" -ge 8 ] && [ "$sid" -le 10 ]; then
      display_id="3"
    fi

    if [ "$sid" -ge 11 ]; then
      display_id="2"
    fi


    sketchybar --add item "space.$sid" left \
      --set "space.$sid" display="$display_id" \
      --subscribe "space.$sid" aerospace_workspace_change \
      --set "space.$sid" \
      drawing=on \
      background.color="$ITEM_BG" \
      background.corner_radius=5 \
      background.drawing=on \
      background.border_color="$PASTEL_GREEN" \
      background.border_width=0 \
      background.height=25 \
      icon.color="$ACCENT" \
      icon="$sid" \
      icon.padding_left=10 \
      icon.shadow.distance=4 \
      label.font="sketchybar-app-font:Regular:16.0" \
      label.padding_right=20 \
      label.padding_left=0 \
      label.y_offset=-1 \
      label.shadow.drawing=off \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
  done
done

# Load Icons on startup for all monitors
for monitor in $(aerospace list-monitors); do
  for sid in $(aerospace list-workspaces --monitor "$monitor" --empty no); do
    apps=$(aerospace list-windows --workspace "$sid" | awk -F'|' '{gsub(/^ *| *$/, "", $2); print $2}')

    sketchybar --set "space.$sid" drawing=on

    icon_strip=" "
    if [ "${apps}" != "" ]; then
      while read -r app; do
        icon_strip+=" $("$PLUGIN_DIR"/icon_map_fn.sh "$app")"
      done <<<"${apps}"
    else
      icon_strip=""
    fi
    sketchybar --set space."$sid" label="$icon_strip"
  done
done


# ------------------------------------------------------------
# Adding Front App
# ------------------------------------------------------------
sketchybar --add item front_app left \
           --set front_app \
             icon="$ICON_APP" \
             icon.font="sketchybar-app-font:Regular:17.0" \
             update_freq=2 \
             script="$PLUGIN_DIR/front_app.sh"


# ------------------------------------------------------------
# CENTER: Current Media
# ------------------------------------------------------------

sketchybar --add item media center \
           --set media \
             drawing=off \
             update_freq=3 \
             script="$PLUGIN_DIR/media.sh" \
             label.max_chars=60

# ------------------------------------------------------------
# RIGHT: The rest (ordered and grouped in a way that makes sense for me)
# ------------------------------------------------------------

# Clock
sketchybar --add item clock right \
           --set clock \
             icon="$ICON_CLOCK" \
             update_freq=10 \
             script="$PLUGIN_DIR/clock.sh"

# Battery
sketchybar --add item battery right \
           --set battery \
             icon="$ICON_BATTERY" \
             update_freq=30 \
             script="$PLUGIN_DIR/battery.sh"

# VPN
sketchybar --add item vpn right \
           --set vpn \
             icon.font="$ICON_FONT" \
             icon="$ICON_UNLOCK" \
             update_freq=5 \
             script="$PLUGIN_DIR/vpn.sh" \
             popup.align=right \
           --subscribe vpn mouse.entered mouse.exited

# Popup content (hidden unless hovered)
sketchybar --add item vpn.popup popup.vpn \
           --set vpn.popup \
             label="VPN Status" \
             icon.drawing=off \
             background.color="$BAR_BG" \
             background.height=24

# # Volume
# sketchybar --add item volume right \
#            --set volume \
#              icon="$ICON_VOLUME" \
#              update_freq=2 \
#              script="$PLUGIN_DIR/volume.sh"

sketchybar --set battery icon.color="$C_BATTERY"
sketchybar --set clock icon.color="$C_CLOCK"
sketchybar --set vpn icon.color="$C_MEDIA"
# sketchybar --set volume icon.color=$C_VOLUME

# ------------------------------------------------------------
# EVENTS: Theme change support
# ------------------------------------------------------------

sketchybar --add event theme_changed

sketchybar --add item theme_handler right \
           --set theme_handler \
             drawing=off \
             script="$PLUGIN_DIR/theme.sh" \
           --subscribe theme_handler theme_changed

# Apply current theme colors on startup
"$PLUGIN_DIR/theme.sh"

sketchybar --update
