# File: ~/.config/ghostty/config
# Reload: Cmd+Shift+, (macOS)
# View options: ghostty +show-config --default --docs

# -- Typography ---
font-family = "iA Writer Mono V Text"
font-feature = -calt
font-feature = -liga
font-size = 16
font-thicken = true
adjust-cell-height = 10%

# --- Theme and Colors
# Custom themes matching dotfiles theme system
theme = jubi

# --- Window and Appearance ---
background-opacity = 0.98
background-image = ~/.config/ghostty/backgrounds/tamagotchi-rainbow-clouds-wallpaper-kawaii-hoshi.jpg
background-image-opacity = 0.125
background-image-fit = cover
background-image-position = center
unfocused-split-opacity = 0.8
background-blur-radius = 20
window-padding-x = 10
window-padding-y = 8
window-padding-color = extend-always
window-padding-balance = true
window-save-state = always
window-step-resize = true

custom-shader = shaders/cursor_warp.glsl

# --- Cursor ---
adjust-cursor-thickness = 2
cursor-style = block
cursor-style-blink = true
custom-shader-animation = always
cursor-opacity = 0.8

# --- Mouse ---
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- Quick Terminal ---
quick-terminal-position = bottom
quick-terminal-screen = main
quick-terminal-size     = 45%, 90%
quick-terminal-animation-duration = 0.1
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- MacOS Specific ---
macos-auto-secure-input = false
macos-non-native-fullscreen   = visible-menu
macos-option-as-alt = false
macos-titlebar-style          = tabs
macos-window-shadow           = false
macos-secure-input-indication = false
macos-shortcuts = deny

# --- Shell Integration ---
shell-integration = detect
shell-integration-features = cursor,sudo,no-title
clipboard-trim-trailing-spaces = true

# --- Keybindings ---
# Windows
keybind = ctrl+n=new_window

