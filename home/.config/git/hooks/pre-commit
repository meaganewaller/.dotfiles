#!/usr/bin/env bash
# Global pre-commit hook
# Runs global hooks first, then delegates to local hooks
#
# Setup: git config --global core.hooksPath ~/.config/git/hooks
#
# To add repo-specific hooks alongside global hooks:
#   1. Rename .git/hooks/pre-commit to .git/hooks/pre-commit.local
#   2. Or just use .pre-commit-config.yaml (auto-detected)

set -euo pipefail

GLOBAL_HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
GIT_DIR="$(git rev-parse --git-dir 2>/dev/null)"
LOCAL_HOOKS_DIR="$GIT_DIR/hooks"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

# ============================================================================
# Global Hooks
# ============================================================================

# Tradeoff gate backend selection:
# - codex (default): use codex-tradeoff-gate
# - claude: use tradeoff-gate
# - both: run codex then claude
# - off: skip global tradeoff gate
TRADEOFF_GATE_BACKEND="${TRADEOFF_GATE_BACKEND:-codex}"

run_gate() {
  local gate="$1"
  [[ -x "$gate" ]] || return 0
  "$gate" || exit $?
}

case "$TRADEOFF_GATE_BACKEND" in
  codex)
    run_gate "$HOME/.local/bin/codex-tradeoff-gate"
    ;;
  claude)
    run_gate "$HOME/.local/bin/tradeoff-gate"
    ;;
  both)
    run_gate "$HOME/.local/bin/codex-tradeoff-gate"
    run_gate "$HOME/.local/bin/tradeoff-gate"
    ;;
  off)
    ;;
  *)
    echo "Unknown TRADEOFF_GATE_BACKEND=$TRADEOFF_GATE_BACKEND (use codex|claude|both|off)" >&2
    exit 1
    ;;
esac

# Add more global hooks here as needed...

# ============================================================================
# Delegate to Local Hooks
# ============================================================================

# Option 1: Local hook renamed to .local suffix
if [[ -x "$LOCAL_HOOKS_DIR/pre-commit.local" ]]; then
  "$LOCAL_HOOKS_DIR/pre-commit.local" "$@" || exit $?
fi

# Option 2: pre-commit framework (most common)
if [[ -f "$REPO_ROOT/.pre-commit-config.yaml" ]]; then
  if command -v pre-commit &>/dev/null; then
    # Run pre-commit with explicit config path
    pre-commit run --config "$REPO_ROOT/.pre-commit-config.yaml" || exit $?
  fi
fi

exit 0
