[user]
	name = Meagan Waller

[init]
  defaultBranch = main

[core]
  excludesfile = ~/.gitignore_global
  autocrlf = input
  pager = delta

[pager]
  diff = delta
  status = true

[interactive]
  diffFilter = delta --color-only

[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f

[color]
  ui = auto

[alias]
  co = checkout
  st = status -sb
  ci = commit
  br = branch
  lg = log --oneline --graph --decorate --all

[delta]
  features = collared-trogon
  navigate = true
  side-by-side = true
  line-numbers = true

[help]
  autocorrect = 1

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  verbose = true
  gpgsign = true

# Local machine overrides (never committed)
[include]
  path = ~/.gitconfig.local

