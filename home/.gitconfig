[user]
  name = Meagan Waller

[init]
  defaultBranch = main

[push]
  autoSetupRemote = true

[core]
  autocrlf = input
  editor = nvim
  excludesfile = ~/.gitignore_global
  hooksPath = ~/.config/git/hooks
  pager = delta

[pager]
  diff = delta
  status = true

[diff]
  colorMoved = default
  algorithm = patience # more intelligent diff algorithm

[interactive]
  diffFilter = delta --color-only

[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f

[color]
  ui = auto
  branch = auto
  diff = auto
  interactive = auto
  status = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red
	new = green

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[column]
  ui = auto

[branch]
  sort = -committerdate

[log]
  date = relative

[alias]
  br = branch
  ci = commit
  co = checkout
  lg = log --oneline --graph --decorate --all
  st = status -sb

  # Logging improvements
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	lga = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all

  # Show files in a commit
  show-files = show --pretty="" --name-only

  # Undo last commit
  undo = reset HEAD~1 --mixed

  # Clean up merged branches
  cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"

  # Interactive rebase
  ri = rebase -i

	# Show current branch
	current = branch --show-current

[status]
  showUntrackedFiles = all

[delta]
  navigate = true
  light = false
  side-by-side = true
  line-numbers = true
  syntax-theme = Monokai Extended
  diff-so-fanacy = true
  max-line-length = 200 # prevent overly wide diffs

[delta "interactive"]
  keep-plus-minus-markers = false

[merge]
  conflictstyle = diff3

[help]
  autocorrect = 1

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  verbose = true
  gpgsign = true

# Local machine overrides (never committed)
[include]
  path = ~/.gitconfig.local
[maintenance]
	repo = /Users/meagan.waller/workspace/web
