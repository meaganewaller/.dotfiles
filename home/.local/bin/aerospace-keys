#!/usr/bin/env bash
# aerospace-keys - Display aerospace keybindings cheat sheet
# Trigger with karabiner shortcut or run directly

set -euo pipefail

# Colors for output
BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[36m'
YELLOW='\033[33m'
GREEN='\033[32m'
MAGENTA='\033[35m'
NC='\033[0m'

print_header() {
  echo -e "\n${BOLD}${CYAN}═══ $1 ═══${NC}\n"
}

print_key() {
  local key="$1"
  local desc="$2"
  printf "  ${YELLOW}%-20s${NC} ${DIM}→${NC} %s\n" "$key" "$desc"
}

print_section() {
  echo -e "\n${BOLD}${MAGENTA}$1${NC}"
}

show_cheatsheet() {
  clear
  echo -e "${BOLD}${GREEN}"
  echo "    ╔═══════════════════════════════════════════════════════╗"
  echo "    ║           AEROSPACE KEYBOARD SHORTCUTS                ║"
  echo "    ╚═══════════════════════════════════════════════════════╝"
  echo -e "${NC}"

  print_section "NAVIGATION (Focus)"
  print_key "alt + h/j/k/l" "Focus left/down/up/right"
  print_key "alt + ctrl + h/l" "Focus monitor left/right"
  print_key "alt + ctrl + j" "Focus next monitor (wrap)"
  print_key "alt + tab" "Back and forth between workspaces"

  print_section "WINDOW MOVEMENT"
  print_key "alt + shift + h/j/k/l" "Move window left/down/up/right"
  print_key "alt + shift + tab" "Move workspace to next monitor"
  print_key "alt + shift + <ws>" "Move window to workspace"

  print_section "LAYOUT"
  print_key "alt + /" "Toggle tiles horizontal/vertical"
  print_key "alt + ," "Toggle accordion horizontal/vertical"
  print_key "alt + -" "Resize smaller"
  print_key "alt + =" "Resize larger"

  print_section "WORKSPACES - Main Monitor (1-7)"
  print_key "alt + 1-7" "Switch to workspace 1-7"
  echo -e "  ${DIM}Primary work: code, browser, focus tasks${NC}"

  print_section "WORKSPACES - Dell Vertical (S/M/D/C)"
  print_key "alt + s" "Slack"
  print_key "alt + m" "Messages / Mail"
  print_key "alt + d" "Docs / Documentation"
  print_key "alt + c" "Calendar"

  print_section "WORKSPACES - Built-in (E/Y/P/8/9)"
  print_key "alt + e" "Entertainment"
  print_key "alt + y" "YouTube / Media"
  print_key "alt + p" "Personal"
  print_key "alt + 8/9" "Overflow"

  print_section "SERVICE MODE (alt + shift + ;)"
  print_key "esc" "Reload config"
  print_key "r" "Reset/flatten layout"
  print_key "f" "Toggle floating/tiling"
  print_key "backspace" "Close all windows but current"
  print_key "alt+shift + h/j/k/l" "Join with adjacent"
  print_key "up/down" "Volume up/down"

  echo -e "\n${DIM}Press any key to close...${NC}"
}

# Check if we should use gum for fancy display
if command -v gum &>/dev/null && [[ -t 1 ]]; then
  # Use gum pager for scrollable view
  show_cheatsheet | gum pager
else
  show_cheatsheet
  read -rsn1
fi
