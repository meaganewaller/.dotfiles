#!/usr/bin/env bash
set -euo pipefail

MODE="${WEEKLY_REVIEW_MODE:-}"
if [[ -z "$MODE" ]]; then
  PROFILE="${DOTFILES_PROFILE:-work}"
  case "$PROFILE" in
    work) MODE="claude" ;;
    personal) MODE="codex" ;;
    *) MODE="combined" ;;
  esac
fi
while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      MODE="${2:-}"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      echo "Usage: codex-weekly-review [--mode codex|claude|combined]" >&2
      exit 1
      ;;
  esac
done

case "$MODE" in
  codex|claude|combined) ;;
  *)
    echo "Invalid mode: $MODE (use codex|claude|combined)" >&2
    exit 1
    ;;
esac

SCRIPTS_DIR="$HOME/.codex/devos/skills/weekly-review/scripts"
if [[ ! -d "$SCRIPTS_DIR" ]]; then
  DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/github/meaganewaller/.dotfiles}"
  SCRIPTS_DIR="$DOTFILES_ROOT/home/.codex/devos/skills/weekly-review/scripts"
fi

if [[ ! -x "$SCRIPTS_DIR/run_weekly_review.sh" ]]; then
  echo "Missing weekly-review scripts at $SCRIPTS_DIR" >&2
  exit 1
fi

OUT_DIR=$(WEEKLY_REVIEW_MODE="$MODE" bash "$SCRIPTS_DIR/run_weekly_review.sh")
echo "Review artifacts: $OUT_DIR"
echo "Mode: $MODE"
echo "Next: fill placeholders in $OUT_DIR/review.md, then run:"
echo "  bash $SCRIPTS_DIR/finalize_review.sh $OUT_DIR"
