#!/usr/bin/env bash
# aerospace-keys-popup - Open aerospace keybindings in a floating terminal
# Designed to be triggered by karabiner

set -euo pipefail

KEYS_SCRIPT="$HOME/.local/bin/aerospace-keys"

# Full paths for when running from karabiner (limited PATH)
WEZTERM="/opt/homebrew/bin/wezterm"

# Use WezTerm if available
if [[ -x "$WEZTERM" ]]; then
  # Open WezTerm and run the keys script
  open -na "WezTerm" --args start -- /bin/bash -l -c "$KEYS_SCRIPT"
else
  # Fallback to Terminal.app
  osascript <<EOF
tell application "Terminal"
    do script "$KEYS_SCRIPT"
    activate
end tell
EOF
fi
