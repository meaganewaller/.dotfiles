#!/usr/bin/env bash
set -euo pipefail

# Tradeoff Gate - Pre-commit hook that prompts for tradeoff documentation on large changes
#
# Triggers when staged changes exceed TRADEOFF_THRESHOLD lines (default: 50)
# Bypass with: SKIP_TRADEOFF=1 git commit ...
# Or: git commit --no-verify (skips all pre-commit hooks)
#
# Tradeoffs are saved to ~/.claude/decision-journal/

THRESHOLD="${TRADEOFF_THRESHOLD:-50}"
JOURNAL_DIR="${TRADEOFF_JOURNAL:-$HOME/.claude/decision-journal}"

# Skip if explicitly bypassed
if [[ "${SKIP_TRADEOFF:-}" == "1" ]]; then
  exit 0
fi

# Skip in non-interactive environments (CI, etc.)
if [[ ! -t 0 ]]; then
  exit 0
fi

# Count staged diff lines (additions + deletions)
DIFF_STATS=$(git diff --cached --numstat 2>/dev/null | awk '{added+=$1; deleted+=$2} END {print added+0, deleted+0}')
ADDED=$(echo "$DIFF_STATS" | cut -d' ' -f1)
DELETED=$(echo "$DIFF_STATS" | cut -d' ' -f2)
TOTAL=$((ADDED + DELETED))

# Skip if under threshold
if (( TOTAL < THRESHOLD )); then
  exit 0
fi

# Get list of changed files for context
CHANGED_FILES=$(git diff --cached --name-only | head -10)
FILE_COUNT=$(git diff --cached --name-only | wc -l | tr -d ' ')

# Colors
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
GREEN='\033[0;32m'
NC='\033[0m'

echo
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${YELLOW}  Large Change Detected: ${TOTAL} lines (+${ADDED}/-${DELETED}) across ${FILE_COUNT} files${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo
echo -e "${BLUE}Files:${NC}"
echo "$CHANGED_FILES" | sed 's/^/  /'
if (( FILE_COUNT > 10 )); then
  echo "  ... and $((FILE_COUNT - 10)) more"
fi
echo
echo -e "${BLUE}Document the tradeoff (30 seconds):${NC}"
echo "  What did you choose NOT to do, and why?"
echo
echo -e "  Options:"
echo -e "    ${GREEN}[d]${NC} Document tradeoff (opens editor)"
echo -e "    ${GREEN}[q]${NC} Quick note (one-liner)"
echo -e "    ${GREEN}[s]${NC} Skip this time"
echo -e "    ${GREEN}[n]${NC} Not a tradeoff (trivial change)"
echo

read -r -p "Choice [d/q/s/n]: " choice

case "${choice,,}" in
  d|doc|document)
    # Create journal entry with template
    mkdir -p "$JOURNAL_DIR"
    TIMESTAMP=$(date +%Y-%m-%d-%H%M)
    BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
    ENTRY_FILE="$JOURNAL_DIR/$TIMESTAMP-tradeoff.md"

    cat > "$ENTRY_FILE" << EOF
# Tradeoff: $(date +%Y-%m-%d)

**Branch:** $BRANCH
**Files changed:** $FILE_COUNT (+$ADDED/-$DELETED lines)

## What I chose to do


## What I chose NOT to do


## Why

<!-- What constraints, priorities, or principles drove this decision? -->

## Revisit if

<!-- Under what conditions should this decision be reconsidered? -->

## Principles Applied

<!-- Which career matrix behaviors guided this decision? See ~/.claude/principles/career-matrix.md -->
<!-- Examples: Making Principled Choices, Simplifying For Change, Norming On Conventions -->

---
*Files:*
$(echo "$CHANGED_FILES" | sed 's/^/- /')
EOF

    # Open in editor
    ${EDITOR:-vi} "$ENTRY_FILE"

    # Check if user actually wrote something
    if grep -q "^## What I chose to do$" "$ENTRY_FILE" && \
       ! grep -qE "^## What I chose to do\s*$" "$ENTRY_FILE"; then
      echo -e "${GREEN}✓ Tradeoff documented: $ENTRY_FILE${NC}"
    else
      echo -e "${YELLOW}⚠ Entry saved but appears empty: $ENTRY_FILE${NC}"
    fi
    ;;

  q|quick)
    echo
    read -r -p "Quick tradeoff note: " note
    if [[ -n "$note" ]]; then
      mkdir -p "$JOURNAL_DIR"
      TIMESTAMP=$(date +%Y-%m-%d-%H%M)
      BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
      ENTRY_FILE="$JOURNAL_DIR/$TIMESTAMP-tradeoff.md"

      cat > "$ENTRY_FILE" << EOF
# Tradeoff: $(date +%Y-%m-%d)

**Branch:** $BRANCH
**Files changed:** $FILE_COUNT (+$ADDED/-$DELETED lines)

## Note

$note

---
*Files:*
$(echo "$CHANGED_FILES" | sed 's/^/- /')
EOF
      echo -e "${GREEN}✓ Quick note saved: $ENTRY_FILE${NC}"
    fi
    ;;

  s|skip)
    echo -e "${YELLOW}⚠ Skipping tradeoff documentation${NC}"
    ;;

  n|no|none|trivial)
    echo -e "${GREEN}✓ Marked as non-tradeoff change${NC}"
    ;;

  *)
    echo -e "${YELLOW}⚠ Unknown choice, proceeding with commit${NC}"
    ;;
esac

echo
exit 0
