#!/usr/bin/env bash
set -euo pipefail

THEME_DIR="${HOME}/.config/theme"
THEMES_DIR="${THEME_DIR}/themes"
CURRENT="${THEME_DIR}/current.json"
APPLY="${THEME_DIR}/apply/apply.sh"

die() { echo "theme: $*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

ensure_dirs() {
  mkdir -p "${THEMES_DIR}" "${THEME_DIR}/apply"
}

usage() {
  cat <<EOF
theme list
theme current
theme set light|dark|<name> [--seed today|YYYY-MM-DD|<string>]
theme next [light|dark]
theme prev [light|dark]
theme apply
theme validate [<name>]
EOF
}

# Run python with stdin script
python_pick() {
  python3 - "$@"
}

# Write CURRENT atomically (avoid partial JSON if interrupted)
write_current_from_file() {
  local src="$1"
  local tmp
  tmp="$(mktemp "${CURRENT}.tmp.XXXXXX")"
  cp -f "$src" "$tmp"
  mv -f "$tmp" "$CURRENT"
}

ensure_dirs
require_cmd python3

# Check apply script only for commands that need it
require_apply() {
  if [[ ! -f "$APPLY" ]]; then
    die "apply script not found: $APPLY"
  fi
  if [[ ! -x "$APPLY" ]]; then
    die "apply script is not executable: $APPLY (run: chmod +x \"$APPLY\")"
  fi
}

cmd="${1:-}"
shift || true

case "$cmd" in
  list)
    shopt -s nullglob
    files=("${THEMES_DIR}"/*.json)
    shopt -u nullglob
    for f in "${files[@]+"${files[@]}"}"; do
      [[ "$(basename "$f")" == "schema.json" ]] && continue
      basename "$f" .json
    done
    ;;

  current)
    if [[ -f "$CURRENT" ]]; then
      cat "$CURRENT"
    else
      echo "{}"
    fi
    ;;

  set)
    target="${1:-}"
    shift || true
    [[ -n "$target" ]] || die "missing argument (light|dark|<name>)"

    # Parse flags (currently only --seed)
    seed=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --seed)
          seed="${2:-}"
          [[ -n "$seed" ]] || die "missing seed value"
          shift 2
          ;;
        *)
          die "unknown argument: $1"
          ;;
      esac
    done

    if [[ "$seed" == "today" ]]; then
      seed="$(date +%F)"
    fi

    if [[ "$target" == "light" || "$target" == "dark" ]]; then
      picked="$(
        python_pick <<'PY' "${THEMES_DIR}" "${target}" "${seed}"
import glob, json, os, sys, random, hashlib

themes_dir, mode, seed = sys.argv[1], sys.argv[2], sys.argv[3]
paths = sorted(glob.glob(os.path.join(themes_dir, "*.json")))

candidates = []
for p in paths:
  try:
    with open(p) as f:
      d = json.load(f)
    if d.get("mode") == mode:
      candidates.append((d.get("name") or os.path.splitext(os.path.basename(p))[0], p, d))
  except Exception:
    pass

if not candidates:
  print("")
  sys.exit(0)

if seed:
  h = hashlib.sha256(seed.encode("utf-8")).hexdigest()
  idx = int(h[:8], 16) % len(candidates)
else:
  idx = random.randrange(len(candidates))

print(candidates[idx][1])
PY
)"
      [[ -n "$picked" ]] || die "no themes found with mode=$target"
      write_current_from_file "$picked"
    else
      path="${THEMES_DIR}/${target}.json"
      [[ -f "$path" ]] || die "theme not found: $target"
      write_current_from_file "$path"
    fi

    # Ensure current.json has name + stable accent structure (atomic rewrite)
    tmp="$(mktemp "${CURRENT}.norm.XXXXXX")"
    python_pick <<'PY' "$CURRENT" "$tmp"
import json, os, sys
src, dst = sys.argv[1], sys.argv[2]

with open(src) as f:
  d = json.load(f)

# normalize name
d["name"] = d.get("name") or os.path.splitext(os.path.basename(src))[0]

# normalize accent
accent = d.get("accent")
if isinstance(accent, str):
  d["accent"] = {"name": accent, "hex": None}
elif accent is None:
  d["accent"] = {"name": "amber", "hex": "#E5C07B"}

with open(dst, "w") as f:
  json.dump(d, f, indent=2)
  f.write("\n")
PY
    mv -f "$tmp" "$CURRENT"

    require_apply
    "$APPLY"
    ;;

  next|prev)
    direction="$cmd"
    mode_arg="${1:-}" # optional override
    shift || true

    picked="$(
      python_pick <<'PY' "${THEMES_DIR}" "${CURRENT}" "${direction}" "${mode_arg}"
import glob, json, os, sys

themes_dir, current_path, direction, mode_arg = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

cur = {}
try:
  with open(current_path) as f:
    cur = json.load(f)
except Exception:
  pass

cur_name = cur.get("name")
cur_mode = mode_arg or cur.get("mode") or "dark"

paths = sorted(glob.glob(os.path.join(themes_dir, "*.json")))
themes = []
for p in paths:
  try:
    with open(p) as f:
      d = json.load(f)
    name = d.get("name") or os.path.splitext(os.path.basename(p))[0]
    if d.get("mode") == cur_mode:
      themes.append((name, p))
  except Exception:
    pass

if not themes:
  print("")
  sys.exit(0)

names = [n for n,_ in themes]
i = names.index(cur_name) if cur_name in names else 0

step = 1 if direction == "next" else -1
j = (i + step) % len(themes)
print(themes[j][1])
PY
)"
    [[ -n "$picked" ]] || die "no themes found for cycling"

    write_current_from_file "$picked"
    require_apply
    "$APPLY"
    ;;

  apply)
    require_apply
    "$APPLY"
    ;;

  validate)
    target="${1:-}"
    shift || true

    WALLPAPERS_DIR="${THEME_DIR}/wallpapers"

    validate_theme() {
      local path="$1"
      local name
      name="$(basename "$path" .json)"

      python_pick <<'PY' "$path" "$WALLPAPERS_DIR"
import json, sys, os

path, wallpapers_dir = sys.argv[1], sys.argv[2]
name = os.path.splitext(os.path.basename(path))[0]
errors = []
warnings = []

# Check JSON is valid
try:
  with open(path) as f:
    d = json.load(f)
except json.JSONDecodeError as e:
  print(f"  ERROR: invalid JSON: {e}")
  sys.exit(1)
except Exception as e:
  print(f"  ERROR: cannot read file: {e}")
  sys.exit(1)

# Check required fields
if not d.get("name"):
  errors.append("missing required field: name")
if not d.get("mode"):
  errors.append("missing required field: mode")
elif d.get("mode") not in ("light", "dark"):
  errors.append(f"invalid mode: {d.get('mode')} (must be 'light' or 'dark')")

# Check wallpaper exists (warning only)
wallpaper = d.get("wallpaper")
if wallpaper:
  if not wallpaper.startswith("/"):
    wallpaper_path = os.path.join(wallpapers_dir, wallpaper)
  else:
    wallpaper_path = wallpaper
  if not os.path.isfile(wallpaper_path):
    warnings.append(f"wallpaper not found: {wallpaper_path}")

# Report results
for e in errors:
  print(f"  ERROR: {e}")
for w in warnings:
  print(f"  WARNING: {w}")

if errors:
  sys.exit(1)
elif warnings:
  sys.exit(0)
else:
  print("  OK")
  sys.exit(0)
PY
    }

    if [[ -n "$target" ]]; then
      # Validate single theme
      path="${THEMES_DIR}/${target}.json"
      [[ -f "$path" ]] || die "theme not found: $target"
      echo "Validating theme: $target"
      validate_theme "$path"
    else
      # Validate all themes
      shopt -s nullglob
      files=("${THEMES_DIR}"/*.json)
      shopt -u nullglob

      if [[ ${#files[@]} -eq 0 ]]; then
        echo "No themes found in ${THEMES_DIR}"
        exit 0
      fi

      has_errors=0
      for f in "${files[@]}"; do
        name="$(basename "$f" .json)"
        echo "Validating theme: $name"
        if ! validate_theme "$f"; then
          has_errors=1
        fi
      done

      if [[ $has_errors -eq 1 ]]; then
        exit 1
      fi
    fi
    ;;

  ""|-h|--help|help)
    usage
    ;;

  *)
    usage
    exit 1
    ;;
esac
