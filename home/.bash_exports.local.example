# Machine-specific environment exports
# This file is not version-controlled - customize for your specific machine.
# Copy this file to home/.bash_exports.local and modify as needed.

# ==== DOTFILES LOCATION ====
# Set this if you cloned dotfiles to a non-standard location
# Default location is ~/github/meaganewaller/.dotfiles - only set this if you cloned elsewhere
# See README.md "Custom Clone Location" section for details
# export DOTFILES_ROOT="$HOME/my/custom/dotfiles/path"

# ==== ENVIRONMENT CONFIGURATION ====
# Set to "true" on work machines, "false" on personal machines
# Controls which MCP servers are enabled/disabled
export DOTFILES_PROFILE={$DOTFILES_PROFILE:-work}
WORK_MACHINE="false"
if [[ $DOTFILES_PROFILE -eq "work" ]]; then
    WORK_MACHINE="true"
fi

# ==== MACHINE-SPECIFIC EXPORTS ====
# Add any other machine-specific environment variables here
# Examples:
# export CUSTOM_PATH="/path/specific/to/this/machine"
# export MACHINE_ROLE="development"
