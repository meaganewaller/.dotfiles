{
    // Read permissions for specific files for Common profile
    // NOTE: to add reading directories, use the additional-dirs.jsonc file
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Read(~/.zshrc)"
        ],
        "deny": [
            "Read(~/.ssh/**)",
            "Read(~/.gnupg/**)",
            "Read(~/.aws/**)",
            "Read(~/.azure/**)",
            "Read(~/.config/gh/**)",
            "Read(~/.git-credentials)",
            "Read(~/.docker/config.json)",
            "Read(~/.kube/**)",
            "Read(~/.npmrc)",
            "Read(~/.npm/**)",
            "Read(~/.pypirc)",
            "Read(~/.gem/credentials)",
            "Read(~/Library/Keychains/**)",
            "Read(.env)"
        ]
    }
}
