{
    // Common hooks configuration for Claude Code, ordered alphabetically.
    // These hooks execute in response to events during Claude Code's operation
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/loop-detector.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/principle-activator.sh"
                    }
                ]
            },
            {
                "matcher": "MultiEdit|Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/impact-extractor.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/large-diff-escalator.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/dependency-change-detector.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/reversal-detector.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/tradeoff-capture.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/async-test-runner.sh",
                        "async": true
                    }
                ]
            },
            {
                "matcher": "Skill",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/skill-usage-tracker.sh"
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "Bash|Task|Read|Write|Edit|Glob|Grep|mcp__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUseFailure/skill-gap-detector.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/Stop/response-topics-writer.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/Stop/hard-stop-test-blocker.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/Stop/tradeoff-context-prep.sh"
                    },
                    {
                        "prompt": "You are extracting tradeoff documentation from a session that made large code changes.\n\nHook input JSON:\n$ARGUMENTS\n\nYour task:\n\n1. Check ~/.claude/pending-tradeoffs/ for marker files with captured: false\n2. If no uncaptured markers exist, return: { \"ok\": true }\n\n3. For each uncaptured marker, analyze the session context (last_assistant_message) for:\n   - Why specific implementation approaches were chosen\n   - What alternatives were considered or rejected\n   - Trade-offs made (speed vs safety, flexibility vs simplicity, etc.)\n   - Engineering principles that guided decisions\n\n4. If meaningful tradeoff reasoning is found:\n   - Extract: decision_summary, tradeoffs, options_considered, principles_invoked\n   - Use the Bash tool to append a JSON line to ~/.claude/dev-os-events.jsonl:\n     {\n       \"timestamp\": \"<ISO8601>\",\n       \"event_type\": \"decision_tradeoff\",\n       \"payload\": {\n         \"decision_summary\": \"...\",\n         \"tradeoffs\": [...],\n         \"options_considered\": [...],\n         \"principles_invoked\": [...],\n         \"files_changed\": [...],\n         \"source\": \"auto-capture\"\n       }\n     }\n   - Update each marker file: set captured: true using Bash with jq\n\n5. If no meaningful reasoning found (mechanical change):\n   - Mark the pending tradeoff as captured anyway\n   - Do not emit an event\n\n6. Return: { \"ok\": true }\n\nImportant:\n- ALWAYS return {\"ok\": true} - never block stopping\n- Only emit events for genuine tradeoffs, not mechanical changes\n- Include source: \"auto-capture\" to distinguish from manual capture",
                        "type": "agent",
                        "timeout": 60
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/Stop/leverage-evaluator.sh"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/UserPromptSubmit/cue-injector-prompt.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/UserPromptSubmit/state-triggers.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/UserPromptSubmit/idea-classifier.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/UserPromptSubmit/session-duration-monitor.sh"
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SubagentStart/cue-inject-subagent.sh"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "matcher": "Explore|Plan",
                "hooks": [
                    {
                        "prompt": "You are extracting architectural reasoning from a subagent session.\n\nHook input JSON:\n$ARGUMENTS\n\nYour task:\n\n1. Inspect `last_assistant_message`.\n2. Determine whether meaningful architectural reasoning occurred.\n   This includes:\n   - Explicit tradeoffs (\"X vs Y\", \"pros/cons\", \"benefits/drawbacks\")\n   - Multiple options evaluated\n   - Design principles invoked (e.g. layering, determinism, separation of concerns, performance, security)\n\nIf NO meaningful reasoning occurred:\nReturn exactly:\n{ \"ok\": true }\n\nIf meaningful reasoning DID occur:\n\nExtract:\n- decision_summary (1 sentence)\n- tradeoffs (array of strings)\n- options_considered (array of strings)\n- principles_invoked (array of strings)\n\nThen use the Write tool to append a single JSON line to:\n~/.claude/dev-os-events.jsonl\n\nThe JSON line must be:\n{\n  \"timestamp\": \"<ISO8601>\",\n  \"event_type\": \"decision_tradeoff\",\n  \"payload\": {\n    \"decision_summary\": \"...\",\n    \"tradeoffs\": [...],\n    \"options_considered\": [...],\n    \"principles_invoked\": [...]\n  }\n}\n\nAfter writing, return exactly:\n{ \"ok\": true }\n\nImportant rules:\n- Do NOT block stopping.\n- Do NOT rewrite or summarize unrelated content.\n- Only emit an event if reasoning is real, not superficial.\n",
                        "type": "agent",
                        "timeout": 60
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionEnd/session-end-tracker.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionEnd/learning-suggestion-generator.sh"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "TaskCreate",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/mark-tasks-active.sh"
                    }
                ]
            },
            {
                "matcher": "Task",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/cue-task-stash.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/cue-injector-bash.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/git-guard.sh"
                    }
                ]
            },
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/cue-injector-file.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/layering-guard.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/principle-reinforcer.sh"
                    }
                ]
            },
            {
                "matcher": "Read",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/large-file-guard.sh"
                    }
                ]
            },
            {
                "matcher": "Glob|Grep",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/bulk-operation-estimator.sh"
                    }
                ]
            }
        ],
        "TaskCompleted": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/TaskCompleted/task-gate.sh"
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreCompact/context-compact-tracker.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreCompact/pre-compact-snapshot.sh"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionStart/session-start-tracker.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionStart/clear-cue-markers.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionStart/session-context-injector.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionStart/friction-escalator.sh"
                    }
                ]
            }
        ],
        "WorktreeCreate": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/WorktreeCreate/worktree-create-log.sh"
                    }
                ]
            }
        ],
        "WorktreeRemove": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/WorktreeRemove/worktree-remove-log.sh"
                    }
                ]
            }
        ]
    }
}
