{
    // Common hooks configuration for Claude Code, ordered alphabetically.
    // These hooks execute in response to events during Claude Code's operation
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/loop-detector.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/principle-activator.sh"
                    }
                ]
            },
            {
                "matcher": "MultiEdit|Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/impact-extractor.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/large-diff-escalator.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/dependency-change-detector.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/reversal-detector.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/tradeoff-capture.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/async-test-runner.sh",
                        "async": true
                    }
                ]
            },
            {
                "matcher": "Skill",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/skill-usage-tracker.sh"
                    }
                ]
            },
            {
                "matcher": "Read",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/read-tracker.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUse/resource-limit-catcher.sh"
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "Bash|Task|Read|Write|Edit|Glob|Grep|mcp__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PostToolUseFailure/skill-gap-detector.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/Stop/response-topics-writer.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/Stop/hard-stop-test-blocker.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/Stop/tradeoff-auto-capture.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/Stop/leverage-evaluator.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/Stop/cost-tracker.sh"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/UserPromptSubmit/cue-injector-prompt.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/UserPromptSubmit/state-triggers.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/UserPromptSubmit/idea-classifier.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/UserPromptSubmit/session-duration-monitor.sh"
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SubagentStart/cue-inject-subagent.sh"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "matcher": "Explore|Plan",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SubagentStop/tradeoff-subagent-capture.sh"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionEnd/session-end-tracker.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionEnd/learning-suggestion-generator.sh"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "TaskCreate",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/mark-tasks-active.sh"
                    }
                ]
            },
            {
                "matcher": "Task",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/cue-task-stash.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/cue-injector-bash.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/git-guard.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/block-destructive.sh"
                    }
                ]
            },
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/cue-injector-file.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/layering-guard.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/principle-reinforcer.sh"
                    }
                ]
            },
            {
                "matcher": "Read",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/large-file-guard.sh"
                    }
                ]
            },
            {
                "matcher": "Glob|Grep",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreToolUse/bulk-operation-estimator.sh"
                    }
                ]
            }
        ],
        "TaskCompleted": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/TaskCompleted/task-gate.sh"
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreCompact/context-compact-tracker.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/PreCompact/pre-compact-snapshot.sh"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionStart/session-start-tracker.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionStart/clear-cue-markers.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionStart/session-context-injector.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/SessionStart/friction-escalator.sh"
                    }
                ]
            }
        ],
        "WorktreeCreate": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/WorktreeCreate/worktree-create-log.sh"
                    }
                ]
            }
        ],
        "WorktreeRemove": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME\"/.claude/hooks/WorktreeRemove/worktree-remove-log.sh"
                    }
                ]
            }
        ]
    }
}
