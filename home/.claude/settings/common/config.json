{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    },
    "includeCoAuthoredBy": true,
    "permissions": {
        "allow": [
            "Read",
            "Glob",
            "Grep"
        ],
        "deny": [
            "Bash(sudo:*)",
            "Bash(su:*)",
            "Bash(chmod 777:*)",
            "Bash(git credential:*)",
            "Bash(git config:*)",
            "Bash(gh auth:*)",
            "Bash(gh secret:*)",
            "Bash(gh ssh-key:*)",
            "Bash(gh gpg-key:*)",
            "Bash(gh codespace:*)",
            "Bash(gh org:*)",
            "Bash(gh config set:*)",
            "Bash(ssh:*)",
            "Bash(scp:*)",
            "Bash(rsync:*)",
            "Bash(apt:*)",
            "Bash(yum:*)",
            "Bash(systemctl:*)",
            "Bash(service:*)",
            "Bash(kill:*)",
            "Bash(killall:*)",
            "Bash(reboot:*)",
            "Bash(shutdown:*)",
            "Bash(passwd:*)",
            "Bash(useradd:*)",
            "Bash(userdel:*)",
            "Bash(groupadd:*)",
            "Bash(nc:*)",
            "Bash(netcat:*)",
            "Bash(telnet:*)",
            "Bash(ftp:*)",
            "Edit(~/.ssh/**)",
            "Edit(~/.keysrc)",
            "Edit(~/.aws/**)",
            "Edit(~/.config/gh/**)",
            "Edit(/etc/**)",
            "Edit(/sys/**)",
            "Edit(/proc/**)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.keysrc)",
            "Read(**/.env)",
            "Read(**/secrets/**)",
            "Read(**/credentials/**)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(git tag:*)",
            "Bash(gh repo create:*)",
            "Bash(gh repo delete:*)",
            "Bash(gh repo fork:*)",
            "Bash(gh repo clone:*)",
            "Bash(gh repo edit:*)",
            "Bash(gh repo transfer:*)",
            "Bash(gh pr create:*)",
            "Bash(gh pr close:*)",
            "Bash(gh pr merge:*)",
            "Bash(gh pr review:*)",
            "Bash(gh pr edit:*)",
            "Bash(gh issue create:*)",
            "Bash(gh issue close:*)",
            "Bash(gh issue delete:*)",
            "Bash(gh issue edit:*)",
            "Bash(gh release create:*)",
            "Bash(gh release delete:*)",
            "Bash(gh release upload:*)",
            "Bash(gh gist create:*)",
            "Bash(gh gist delete:*)",
            "Bash(gh gist edit:*)",
            "Bash(gh workflow run:*)",
            "Bash(gh workflow disable:*)",
            "Bash(gh workflow enable:*)"
          ]
    },
    "enableAllProjectMcpServers": true,
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "$HOME/.claude/hooks/notify-stop.sh"
                    }
                ]
            }
        ]
    },
    "enabledPlugins": {},
    "spinnerTipsEnabled": false,
    "alwaysThinkingEnabled": true
}
