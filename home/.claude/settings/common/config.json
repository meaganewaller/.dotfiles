{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    },
    "permissions": {
        "allow": [
            "Read",
            "Glob",
            "Grep"
        ],
        "deny": [
            "Bash(sudo:*)",
            "Bash(su:*)",
            "Bash(chmod 777:*)",
            "Bash(git credential:*)",
            "Bash(git config:*)",
            "Bash(gh auth:*)",
            "Bash(gh secret:*)",
            "Bash(gh ssh-key:*)",
            "Bash(gh gpg-key:*)",
            "Bash(gh codespace:*)",
            "Bash(gh org:*)",
            "Bash(gh config set:*)",
            "Bash(ssh:*)",
            "Bash(scp:*)",
            "Bash(rsync:*)",
            "Bash(apt:*)",
            "Bash(yum:*)",
            "Bash(systemctl:*)",
            "Bash(service:*)",
            "Bash(kill:*)",
            "Bash(killall:*)",
            "Bash(reboot:*)",
            "Bash(shutdown:*)",
            "Bash(passwd:*)",
            "Bash(useradd:*)",
            "Bash(userdel:*)",
            "Bash(groupadd:*)",
            "Bash(nc:*)",
            "Bash(netcat:*)",
            "Bash(telnet:*)",
            "Bash(ftp:*)",
            "Edit(~/.ssh/**)",
            "Edit(~/.keysrc)",
            "Edit(~/.aws/**)",
            "Edit(~/.config/gh/**)",
            "Edit(/etc/**)",
            "Edit(/sys/**)",
            "Edit(/proc/**)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.keysrc)",
            "Read(**/.env)",
            "Read(**/secrets/**)",
            "Read(**/credentials/**)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(git tag:*)",
            "Bash(gh repo create:*)",
            "Bash(gh repo delete:*)",
            "Bash(gh repo fork:*)",
            "Bash(gh repo clone:*)",
            "Bash(gh repo edit:*)",
            "Bash(gh repo transfer:*)",
            "Bash(gh pr create:*)",
            "Bash(gh pr close:*)",
            "Bash(gh pr merge:*)",
            "Bash(gh pr review:*)",
            "Bash(gh pr edit:*)",
            "Bash(gh issue create:*)",
            "Bash(gh issue close:*)",
            "Bash(gh issue delete:*)",
            "Bash(gh issue edit:*)",
            "Bash(gh release create:*)",
            "Bash(gh release delete:*)",
            "Bash(gh release upload:*)",
            "Bash(gh gist create:*)",
            "Bash(gh gist delete:*)",
            "Bash(gh gist edit:*)",
            "Bash(gh workflow run:*)",
            "Bash(gh workflow disable:*)",
            "Bash(gh workflow enable:*)"
          ]
    },
    "enableAllProjectMcpServers": true,
    "enabledPlugins": {},
    "spinnerTipsEnabled": false,
    "alwaysThinkingEnabled": true,
    "hooks": [
        {
            "type": "PreToolUse",
            "matcher": "Bash",
            "description": "Block dev server commands outside tmux to prevent orphaned processes",
            "command": "node ~/.claude/hooks/block-dev-server.js"
        },
        {
            "type": "PreToolUse",
            "matcher": "Bash",
            "description": "Remind before git push to verify branch and remote",
            "command": "node ~/.claude/hooks/pre-push-check.js"
        },
        {
            "type": "PreToolUse",
            "matcher": "Write",
            "description": "Block unnecesssary .md file creation outside of docs directories",
            "command": "node ~/.claude/hooks/block-md-creation.js"
        },
        {
            "type": "PreToolUse",
            "matcher": "Bash",
            "description": "Validate conventional commit message format before git commit",
            "command": "node ~/.claude/hooks/commit-guard.js"
        },
        {
            "type": "PostToolUse",
            "matcher": "Bash",
            "description": "Track edit count and suggest compaction at intervals",
            "command": "node ~/.claude/hooks/suggest-compact.js"
        },
        {
            "type": "SessionStart",
            "description": "Load previous context and detect package manager",
            "command": "node ~/.claude/hooks/session-start.js"
        },
        {
            "type": "SessionStart",
            "description": "Load project context including git state, config files, and pending todos",
            "command": "node ~/.claude/hooks/context-loader.js"
        },
        {
            "type": "SessionEnd",
            "description": "Save current context state for next session",
            "command": "node ~/.claude/hooks/session-end.js"
        },
        {
            "type": "SessionEnd",
            "description": "Save session learnings and recent commits to daily log",
            "command": "node ~/.claude/hooks/learning-log.js"
        },
        {
            "type": "PreCompact",
            "description": "Save important context before compaction",
            "command": "node ~/.claude/hooks/pre-compact.js"
        },
        {
            "type": "Notification",
            "description": "Log notifications for later review",
            "command": "node ~/.claude/hooks/notification-log.js"
        },
        {
            "type": "UserPromptSubmit",
            "description": "Detect vague prompts and suggest clarification",
            "command": "node ~/.claude/hooks/prompt-check.js"
        }
    ]
}
