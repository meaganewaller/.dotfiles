{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devos.local/schemas/cost_tracked",
  "title": "Cost Tracked Event",
  "description": "Emitted when token usage and cost are recorded for a session",
  "type": "object",
  "required": ["model", "input_tokens", "output_tokens", "cost_usd"],
  "properties": {
    "model": {
      "type": "string",
      "description": "Model identifier used for the session"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of input tokens consumed"
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of output tokens generated"
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated cost in USD"
    }
  },
  "additionalProperties": false
}
